@inherits LayoutComponentBase
@inject AuthStateService AuthStateService
@inject PresenceService PresenceService
@inject MessageService MessageService
@inject NavigationManager Navigation

@* Below the shell breakpoint the sidebar is an overlaying drawer driven by _navOpen; above
   it, the same markup is the static column and the toggle/overlay are display:none. State
   lives here rather than in NavMenu so the toggle can sit in the top bar. *@
<div class="page">
	<div class="sidebar @(_navOpen ? "sidebar--open" : null)">
		<NavMenu OnNavigate="CloseNav"/>
	</div>

	<div class="nav-overlay @(_navOpen ? "nav-overlay--visible" : null)" @onclick="CloseNav"></div>

	<main>
		<header class="topbar">
			@* A plain button rather than <IconButton> on purpose: this element is shown and
			   hidden by the shell's own breakpoint, and a parent's isolated CSS cannot
			   reach a child component's root element to do that. *@
			<div class="topbar__lead">
				<button type="button" class="topbar__toggle"
				        title="@UiText.Layout.NavigationMenu"
				        aria-label="@UiText.Layout.NavigationMenu"
				        aria-expanded="@_navOpen"
				        @onclick="ToggleNav">
					<i class="bi bi-@(_navOpen ? "x-lg" : "list")" aria-hidden="true"></i>
				</button>
				<a class="topbar__brand" href="">
					<i class="bi bi-basket2-fill" aria-hidden="true"></i>
					<span>FoodHub</span>
				</a>
			</div>

			<div class="topbar__actions">
				<ThemeToggle/>
				@if (!string.IsNullOrEmpty(userEmail))
				{
					<span class="topbar__email fh-truncate" title="@userEmail">
                        <i class="bi bi-person-circle" aria-hidden="true"></i>
						<span class="topbar__email-text">@userEmail</span>
                    </span>
					<AppButton Variant="ButtonVariant.OutlineSecondary" Size="ButtonSize.Small"
					           Icon="box-arrow-right" CssClass="fh-label-optional" OnClick="Logout">@UiText.Layout.Logout
					</AppButton>
				}
				else
				{
					<AppButton Variant="ButtonVariant.Primary" Size="ButtonSize.Small"
					           Icon="box-arrow-in-right" CssClass="fh-label-optional"
					           OnClick='() => Navigation.NavigateTo("/login")'>@UiText.Layout.Login
					</AppButton>
				}
			</div>
		</header>
		<article class="content">
			<div class="content__inner">
				@* Keyed on the current URL so navigating away from a page that threw resets
				   the boundary — without that, the error panel would stick for the rest of
				   the session. *@
				<ErrorBoundary @key="Navigation.Uri">
					<ChildContent>@Body</ChildContent>
					<ErrorContent>
						<div class="fh-render-error" role="alert">
							<i class="bi bi-exclamation-octagon-fill" aria-hidden="true"></i>
							<span>@UiText.Layout.ComponentError</span>
						</div>
					</ErrorContent>
				</ErrorBoundary>
			</div>
		</article>
	</main>

	<BottomNav/>
</div>

<ToastHost/>

<div id="blazor-error-ui">
	@UiText.Layout.UnhandledError
	<a href="" class="reload">@UiText.Layout.Reload</a>
	<a class="dismiss">🗙</a>
</div>

@code {
	private string? userEmail;
	private bool _navOpen;

	/// <summary>Where they are now, path and query, as a site-relative URL.</summary>
	private string CurrentPath => "/" + Navigation.ToBaseRelativePath(Navigation.Uri);

	private void ToggleNav() => _navOpen = !_navOpen;

	private void CloseNav() => _navOpen = false;

	protected override async Task OnInitializedAsync()
	{
		try
		{
			if (!await AuthStateService.IsLoggedInAsync())
			{
				// Nothing to sign out of — an unauthenticated request is exactly what an absent
				// or expired cookie looks like, and the auth middleware has already dealt with
				// it. Just send them to the form, carrying where they were trying to get to so
				// signing in finishes the journey instead of dumping them on the home page. A
				// shared link to a recipe survives the round trip.
				Navigation.NavigateTo($"/login?returnUrl={Uri.EscapeDataString(CurrentPath)}");
				return;
			}

			userEmail = await AuthStateService.GetEmailAsync();

			// Every circuit starts the heartbeat, whichever way it was reached — a fresh login,
			// a reload, a second tab. Start is idempotent.
			PresenceService.Start();
		}
		catch (Exception ex) { MessageService.ShowMessage(ex.Message, true, 20000); }
	}

	// No OnAuthStateChanged subscription any more. The cookie is written and cleared by whole
	// HTTP requests, so a session never begins or ends part-way through a circuit's life — the
	// circuit is torn down and rebuilt with it, and this runs again from the top.

	/// <summary>
	/// Two halves, in this order and no other. The offline ping is authenticated by the JWT
	/// inside the cookie, so it has to go out first; then the trip to the logout route, which is
	/// the only place the cookie can actually be cleared.
	/// </summary>
	private async Task Logout()
	{
		await AuthStateService.SignalSignOutAsync();
		Navigation.NavigateTo(AuthCookie.LogoutPath, forceLoad: true);
	}

}
