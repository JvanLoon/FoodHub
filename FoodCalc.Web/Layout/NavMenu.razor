@using FoodCalc.Web.Services
@using FoodCalc.Web.Services.Auth
@implements IDisposable
@inject AuthStateService AuthStateService
@inject MessageService MessageService

<div class="brand-row">
	<a class="brand" href="">
		<i class="bi bi-basket2-fill" aria-hidden="true"></i>
		<span>FoodHub</span>
	</a>
</div>

<input type="checkbox" title="@UiText.Layout.NavigationMenu" class="navbar-toggler"/>

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
	<nav class="nav-list">
		@if (isLoggedIn)
		{
			<NavItem Href="" Icon="house-door-fill" Label="@UiText.Nav.Home" Match="NavLinkMatch.All"/>
			<NavItem Href="/calendar" Icon="calendar-week" Label="@UiText.Nav.Calendar"/>
			<NavItem Href="/recipes" Icon="journal-text" Label="@UiText.Nav.Recipes"/>
			<NavItem Href="/recipes/find" Icon="search-heart" Label="@UiText.Nav.FindRecipes"/>

			@* Anyone may submit a recipe; it stays private to them until a moderator
			   approves it. *@
			<NavItem Href="/recipes/create" Icon="plus-circle" Label="@UiText.Nav.AddRecipe" Match="NavLinkMatch.All"/>

			@* Staff manage the ingredient catalog — moderators edit it now, not only admins. *@
			@if (isAdmin || isModerator)
			{
				<NavItem Href="/ingredients" Icon="egg" Label="@UiText.Nav.EditIngredients"/>
			}

			@* Same admin page for both; a moderator only gets the review tab within it. *@
			@if (isAdmin || isModerator)
			{
				<NavItem Href="/admin" Icon="gear" Label="@(isAdmin ? UiText.Nav.Admin : UiText.Nav.Review)"/>
			}

			<NavItem Href="/usersettings" Icon="person" Label="@UiText.Nav.UserSettings"/>
		}
	</nav>
</div>

@code {
	private bool isAdmin;
	private bool isModerator;
	private bool isLoggedIn;

	protected override async Task OnInitializedAsync()
	{
		AuthStateService.OnAuthStateChanged += HandleAuthStateChangedAsync;
		await RefreshStateAsync();
	}

	private async Task HandleAuthStateChangedAsync()
	{
		await RefreshStateAsync();
		await InvokeAsync(StateHasChanged);
	}

	private async Task RefreshStateAsync()
	{
		try
		{
			isLoggedIn = await AuthStateService.IsLoggedInAsync();
			isAdmin = isLoggedIn && await AuthStateService.IsAdminAsync();
			isModerator = isLoggedIn && await AuthStateService.IsInAnyRoleAsync("Moderator");
		}
		catch (Exception ex) { MessageService.ShowMessage(ex.Message, true, 0); }
	}

	public void Dispose()
	{
		AuthStateService.OnAuthStateChanged -= HandleAuthStateChangedAsync;
	}

}
