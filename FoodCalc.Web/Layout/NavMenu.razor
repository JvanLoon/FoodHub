@using FoodCalc.Web.Services
@using FoodCalc.Web.Services.Auth
@implements IDisposable
@inject AuthStateService AuthStateService
@inject MessageService MessageService

@* The drawer's own header on mobile; the top of the sidebar column on desktop. *@
<div class="brand-row">
	<a class="brand" href="" @onclick="OnNavigate">
		<i class="bi bi-basket2-fill" aria-hidden="true"></i>
		<span>FoodHub</span>
	</a>
</div>

@* Always rendered — MainLayout's drawer decides whether it is on screen, so there is no
   toggler here and nothing reaches into the DOM to close itself. *@
<div class="nav-scrollable">
	<nav class="nav-list">
		@if (isLoggedIn)
		{
			@* fh-in-bottom-nav marks the three entries the mobile bottom bar also offers.
			   They stay in the markup and simply hide while that bar is on screen, so the
			   drawer never lists the same destination twice — and the full list comes back
			   above the shell breakpoint, where there is no bar. *@
			<NavItem Href="" Icon="house-door-fill" Label="@UiText.Nav.Home" Match="NavLinkMatch.All" OnNavigate="OnNavigate"/>
			<NavItem Href="/recipes" Icon="journal-text" Label="@UiText.Nav.Recipes" Match="NavLinkMatch.All" OnNavigate="OnNavigate" CssClass="fh-in-bottom-nav"/>
			<NavItem Href="/recipes/find" Icon="search-heart" Label="@UiText.Nav.FindRecipes" OnNavigate="OnNavigate" CssClass="fh-in-bottom-nav"/>

			@* Anyone may submit a recipe; it stays private to them until a moderator
			   approves it. Kept in the sidebar as well as on the Recipes page. *@
			<NavItem Href="/recipes/create" Icon="plus-circle" Label="@UiText.Nav.AddRecipe" Match="NavLinkMatch.All" OnNavigate="OnNavigate"/>

			<NavItem Href="/calendar" Icon="calendar-week" Label="@UiText.Nav.Calendar" OnNavigate="OnNavigate" CssClass="fh-in-bottom-nav"/>
			<NavItem Href="/usersettings" Icon="person" Label="@UiText.Nav.UserSettings" OnNavigate="OnNavigate"/>

			@* One entry, one label for both roles — the tab set inside decides what each of
			   them can actually do. The ingredient catalog lives in there too, which is why
			   it no longer has a sidebar entry of its own. *@
			@if (isAdmin || isModerator)
			{
				<NavItem Href="/admin" Icon="gear" Label="@UiText.Nav.Admin" OnNavigate="OnNavigate"/>
			}
		}
	</nav>
</div>

@code {
	private bool isAdmin;
	private bool isModerator;
	private bool isLoggedIn;

	/// <summary>Raised on every link tap so the mobile drawer can close itself.</summary>
	[Parameter]
	public EventCallback OnNavigate { get; set; }

	protected override async Task OnInitializedAsync()
	{
		AuthStateService.OnAuthStateChanged += HandleAuthStateChangedAsync;
		await RefreshStateAsync();
	}

	private async Task HandleAuthStateChangedAsync()
	{
		await RefreshStateAsync();
		await InvokeAsync(StateHasChanged);
	}

	private async Task RefreshStateAsync()
	{
		try
		{
			isLoggedIn = await AuthStateService.IsLoggedInAsync();
			isAdmin = isLoggedIn && await AuthStateService.IsAdminAsync();
			isModerator = isLoggedIn && await AuthStateService.IsInAnyRoleAsync("Moderator");
		}
		catch (Exception ex) { MessageService.ShowMessage(ex.Message, true, 0); }
	}

	public void Dispose()
	{
		AuthStateService.OnAuthStateChanged -= HandleAuthStateChangedAsync;
	}

}
