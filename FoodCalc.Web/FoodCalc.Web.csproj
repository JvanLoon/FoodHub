<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
      <UserSecretsId>7fc833f3-b805-441d-a866-0f54f5ba5566</UserSecretsId>
  </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Blazored.LocalStorage" Version="4.5.0" />
        <PackageReference Include="DotNetEnv" Version="3.2.0" />
        <!--
          No Authentication.JwtBearer here: this app does not validate tokens and holds no
          signing key. System.IdentityModel.Tokens.Jwt stays because AuthTokenService still
          *reads* claims out of the token, which ReadJwtToken does without a signature check.
        -->
        <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.19.2" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\FoodHub.DTOs\FoodHub.DTOs.csproj" />
        <ProjectReference Include="..\FoodHub.ServiceDefaults\FoodHub.ServiceDefaults.csproj" />
    </ItemGroup>

    <ItemGroup>
        <!-- User-facing message + key constants available to services and components. -->
        <Using Include="FoodCalc.Web.Constants" />
    </ItemGroup>

</Project>
