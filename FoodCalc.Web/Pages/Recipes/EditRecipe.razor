@page "/recipes/create"
@page "/recipes/edit/{RecipeId:guid}"
@inject RecipeService RecipeService
@inject IngredientService IngredientService
@inject AuthStateService AuthStateService
@inject MessageService MessageService
@inject NavigationManager Navigation

<PageTitle>@(IsNew ? UiText.RecipeEditor.CreateTitle : UiText.RecipeEditor.EditTitle)</PageTitle>

<div class="fh-stack">
	@if (_recipe.Id != Guid.Empty && !_recipe.IsReviewed)
	{
		<div class="recipe-pending-banner">
			<i class="bi bi-hourglass-split" aria-hidden="true"></i>
			<span>@WebConstants.Messages.Review.PendingApproval</span>
		</div>
	}

	<div class="recipe-name">
		@if (!_isEditingName)
		{
			<h1 class="fh-heading">@_recipe.Name</h1>
			<IconButton Icon="pencil" Title="@UiText.RecipeEditor.EditNameTitle" OnClick="StartEditName"/>
		}
		else
		{
			<EditForm Model="_nameModel" OnValidSubmit="SaveRecipeName" class="recipe-name__form"
			          FormName="edit-recipe-name">
				<InputText @bind-Value="_editedName" class="form-control"
				           placeholder="@UiText.RecipeEditor.NamePlaceholder"/>
				<AppButton Type="submit" Size="ButtonSize.Small" Icon="check-lg">@UiText.Common.Save</AppButton>
				@* Nothing to fall back to while the recipe is still unsaved. *@
				@if (!IsNew)
				{
					<AppButton Variant="ButtonVariant.OutlineSecondary" Size="ButtonSize.Small"
					           OnClick="CancelEditName">
						@UiText.Common.Cancel
					</AppButton>
				}
			</EditForm>
		}
	</div>

	@if (IsNew)
	{
		<EmptyState Icon="basket" Title="@UiText.RecipeEditor.NameFirstTitle"
		            Message="@UiText.RecipeEditor.NameFirstMessage"/>
	}
	else
	{
		@* Own grid rather than Bootstrap's row/col-md-6: col-md- splits at 768px, which is
		   exactly the width where the sidebar has already become a drawer, so a large phone
		   got two cramped half-columns and a lot of empty page. This splits at the same
		   900px the shell does, and gives the form a fixed track instead of half the page. *@
		<div class="recipe-editor">
			<!-- Left: ingredient form -->
			<div class="recipe-editor__form">
				<AppCard>
					@* Clear sits at the top: it resets the whole form, so it belongs with the
					   field it mainly clears rather than below the save button. *@
					<div class="ingredient-form-head">
						<label for="ingredientSearch" class="form-label">@UiText.RecipeEditor.SearchIngredientLabel</label>
						<AppButton Variant="ButtonVariant.OutlinePrimary" Size="ButtonSize.Small"
						           Icon="x-lg" OnClick="ClearForm">@UiText.RecipeEditor.ClearForm</AppButton>
					</div>

					@* No "+" button any more: an unknown name is created on its way into the
					   recipe (see ResolveIngredientAsync), so there is nothing left to press. *@
					<div class="fh-field">
						<input id="ingredientSearch"
						       class="form-control"
						       type="text"
						       placeholder="@UiText.RecipeEditor.SearchIngredientPlaceholder"
						       @bind="_ingredientSearch"
						       @bind:event="oninput"
						       @onfocus="() => _dropdownOpen = true"
						       @onblur="OnDropdownBlur"
						       autocomplete="off"
						       @onkeydown="HandleIngredientSearchKeydown"
						       @onkeydown:preventDefault="@(_ingredientSearchFocused)"/>
					</div>

					<EditForm Model="_recipeItem" OnValidSubmit="AddOrUpdateIngredient"
					          FormName="add-or-update-ingredient-form">
						<div class="ingredient-dropdown">
							<div class="ingredient-dropdown__menu dropdown-menu @(_dropdownOpen ? "show" : null)">
								@foreach (var ingredient in FilteredIngredients)
								{
									<button type="button"
									        class="dropdown-item @(_recipeItem?.Ingredient is not null && _recipeItem.Ingredient.Name == ingredient.Name ? "active" : "")"
									        @onclick="() => SelectIngredient(ingredient)">
										@ingredient.Name
									</button>
								}
								@if (!FilteredIngredients.Any())
								{
									<div class="dropdown-item disabled">@UiText.RecipeEditor.NoIngredientsFound</div>
								}
							</div>
						</div>

						<NumberField TValue="decimal?" Label="@UiText.RecipeEditor.AmountLabel" @bind-Value="_amountInput"/>

						<SelectField TValue="IngredientAmountTypeDto" Label="@UiText.RecipeEditor.AmountTypeLabel"
						             @bind-Value="_recipeItem!.IngredientAmount">
							@foreach (IngredientAmountTypeDto amountType in Enum.GetValues<IngredientAmountTypeDto>())
							{
								<option value="@amountType">@UiText.AmountTypes.Label(amountType)</option>
							}
						</SelectField>

						<div class="fh-cluster">
							<AppButton Type="submit" Icon="check-lg">@UiText.RecipeEditor.AddOrSave</AppButton>
						</div>
					</EditForm>
				</AppCard>
			</div>

			<!-- Right: current ingredients -->
			<div class="recipe-editor__list">
				@if (_recipe.Ingredients is { Count: > 0 } ingredientsList)
				{
					<ul class="ingredient-list fh-zebra">
						@foreach (var ingredient in ingredientsList)
						{
							<li>
                            <span>@ingredient.Ingredient.Name
	                            <span class="fh-muted">
		                            @ingredient.Amount.ToFormattedString() @UiText.AmountTypes.Label(ingredient.IngredientAmount)
	                            </span>
                            </span>
								<span class="ingredient-list__actions">
                                <IconButton Icon="pencil" Title="@UiText.RecipeEditor.EditIngredient" Size="ButtonSize.Small"
                                            OnClick="() => EditIngredient(ingredient)"/>
                                <IconButton Icon="trash" Title="@UiText.RecipeEditor.DeleteIngredient" Size="ButtonSize.Small"
                                            Variant="ButtonVariant.Danger"
                                            OnClick="() => DeleteIngredient(ingredient.Id)"/>
                            </span>
							</li>
						}
					</ul>
				}
				else
				{
					<EmptyState Icon="basket" Title="@UiText.RecipeEditor.NoIngredientsTitle"
					            Message="@UiText.RecipeEditor.NoIngredientsMessage"/>
				}
			</div>
		</div>
	}
</div>

@code {

	// Null on /recipes/edit — the recipe doesn't exist yet. Creating and editing share this
	// page and its name editor; ingredients can only be added once the recipe exists (needs
	// its id), so saving the name is what creates it and switches the page to the id route.
	[Parameter]
	public Guid? RecipeId { get; set; }

	private bool IsNew => RecipeId is null;

	// Safe to unwrap everywhere it's used: those paths only run in edit mode.
	private Guid CurrentId => RecipeId ?? Guid.Empty;

	private RecipeDto _recipe = new();
	private List<IngredientDto> _ingredients = new();
	private RecipeItemDto? _recipeItem;
	private bool _isEditingName;
	private string _ingredientSearch = string.Empty;

	// Scratch buffer for the name field. The live name is only committed to `recipe.Name`
	// (and the server) on an explicit Save, so cancelling — or navigating away — never
	// mutates the actual recipe name.
	private string _editedName = string.Empty;

	// EditForm needs a model instance; the name lives in `editedName`, so this is just a handle.
	private readonly object _nameModel = new();

	private IEnumerable<IngredientDto> FilteredIngredients => string.IsNullOrWhiteSpace(_ingredientSearch) ? _ingredients : _ingredients.Where(i => i.Name.Contains(_ingredientSearch, StringComparison.OrdinalIgnoreCase));

	private decimal? _amountInput;
	private bool _dropdownOpen;
	private bool _ingredientSearchFocused = false;
	private bool _initialized;

	// The router only supplies route parameters that are present in the URL, so an optional
	// one keeps its old value when the segment disappears. Without this reset, going from
	// /recipes/edit/{id} back to /recipes/edit stays stuck on the recipe you just left.
	public override Task SetParametersAsync(ParameterView parameters)
	{
		RecipeId = null;
		return base.SetParametersAsync(parameters);
	}

	protected override async Task OnInitializedAsync()
	{
		// Creating is open to every signed-in user. Editing an existing recipe is checked
		// against its author once the recipe is loaded (see RefreshRecipeAsync) — the id is
		// not enough to decide here, and the API refuses the write either way.
		await IngredientService.GetAllIngredientsAsync()
			.OnSuccess((data) =>
			{
				_ingredients = data;
				ClearForm();
			})
			.OnFailure();

		_initialized = true;
	}

	// Runs on first render and whenever RecipeId changes (e.g. after create navigates to the
	// edit URL). Loads the recipe for edit mode; resets to a blank recipe for create mode.
	protected override async Task OnParametersSetAsync()
	{
		if (!_initialized)
			return;

		if (IsNew)
		{
			_recipe = new();
			_editedName = string.Empty;
			// Nothing to show but the name form until there's a recipe to name.
			_isEditingName = true;
			return;
		}

		_isEditingName = false;
		_editedName = string.Empty;
		await RefreshRecipeAsync();
	}

	private async Task RefreshRecipeAsync()
	{
		await RecipeService.GetRecipeByIdAsync(CurrentId)
			.OnSuccess((data) => _recipe = data)
			.OnFailure();

		// A recipe you may see but not edit (someone else's, once approved) sends you back to
		// the read-only view rather than showing a form who's every save would be refused.
		if (_recipe.Id != Guid.Empty && !await AuthStateService.CanEditContentAsync(_recipe.CreatedByUserId))
		{
			Navigation.NavigateTo($"/recipe/{_recipe.Id}");
		}
	}

	private async Task AddOrUpdateIngredient(object test)
	{
		// The name may have been typed rather than picked out of the list, and it may not be in
		// the catalog at all — resolving it here is what removed the separate "+" step.
		if (!await ResolveIngredientAsync()) return;

		if (_recipeItem is null) return;

		_recipeItem.RecipeId = CurrentId;
		_recipeItem.Amount = _amountInput ?? 0;

		await RecipeService.AddIngredient(_recipeItem)
			.OnSuccess(message: WebConstants.Messages.Ingredient.AddedOrUpdated)
			.OnFailure();

		ClearForm();
		await RefreshRecipeAsync(); // Refresh the list
	}

	private void EditIngredient(RecipeItemDto ingredient)
	{
		_recipeItem = new RecipeItemDto
		{
			Id = ingredient.Id,
			RecipeId = CurrentId,
			IngredientId = ingredient.IngredientId,
			Ingredient = ingredient.Ingredient,
			Amount = ingredient.Amount,
			IngredientAmount = ingredient.IngredientAmount,
			ShouldBeAddedToShoppingCart = ingredient.ShouldBeAddedToShoppingCart
		};
		_amountInput = ingredient.Amount == 0 ? null : ingredient.Amount;
		_ingredientSearch = ingredient.Ingredient.Name;
	}

	private async Task DeleteIngredient(Guid recipeItemId)
	{
		await RecipeService.DeleteIngredient(recipeItemId)
			.OnSuccess(message: WebConstants.Messages.Ingredient.Deleted)
			.OnFailure();

		ClearForm();
		await RefreshRecipeAsync(); // Refresh the list
	}

	private void ClearForm()
	{
		_ingredientSearch = string.Empty;
		_amountInput = null;
		_recipeItem = null;
	}

	private void StartEditName()
	{
		_editedName = _recipe.Name;
		_isEditingName = true;
	}

	// Saving the name is also what creates the recipe: an unsaved one has no id, and every
	// ingredient write needs one. Both cases go through the same form.
	private async Task SaveRecipeName()
	{
		if (string.IsNullOrWhiteSpace(_editedName))
		{
			MessageService.ShowMessage(WebConstants.Messages.Recipe.NameRequired, isError: true);
			return;
		}

		if (IsNew)
		{
			// Navigating to the id route re-enters OnParametersSetAsync, which loads the
			// recipe and drops the page into normal edit mode.
			await RecipeService.AddRecipe(new CreateRecipeDto
				{
					Name = _editedName.Trim()
				})
				.OnSuccess((data) => Navigation.NavigateTo($"/recipes/edit/{data.Id}"), WebConstants.Messages.Recipe.Created)
				.OnFailure();

			return;
		}

		await RecipeService.UpdateRecipeName(CurrentId, _editedName.Trim())
			.OnSuccess(message: WebConstants.Messages.Recipe.NameUpdated)
			.OnFailure();

		_isEditingName = false;
		await RefreshRecipeAsync(); // Refresh — pulls the committed name back from the server
	}

	/// <summary>
	/// Turns whatever is typed in the search box into a real ingredient on <c>recipeItem</c>:
	/// a name already in the catalog is matched (case-insensitively), an unknown one is created
	/// on the spot. Returns false when there is nothing to resolve or the server refused, in
	/// which case the caller must not go on to save.
	/// </summary>
	private async Task<bool> ResolveIngredientAsync()
	{
		var typed = _ingredientSearch.Trim();

		if (string.IsNullOrWhiteSpace(typed))
			return false;

		if (FindInCatalog(typed) is { } known)
		{
			SelectIngredient(known);
			return true;
		}

		var created = await IngredientService
			.AddIngredientAsync(typed)
			.OnSuccess(SelectIngredient, WebConstants.Messages.Ingredient.Added)
			.OnFailure();

		if (!created.Success)
			return false;

		// The create endpoint answers with nobody, so the catalog is re-read to pick up the
		// row (and its id / shopping-list flag) that was just written.
		_ingredients = await IngredientService.GetAllIngredientsAsync().OrDefault(_ingredients);

		return FindInCatalog(typed) is not null;
	}

	private IngredientDto? FindInCatalog(string name) =>
		_ingredients.FirstOrDefault(i => string.Equals(i.Name, name, StringComparison.OrdinalIgnoreCase));

	private void SelectIngredient(IngredientDto ingredient)
	{
		_recipeItem = new RecipeItemDto
		{
			IngredientId = ingredient.Id,
			Ingredient = ingredient,
			ShouldBeAddedToShoppingCart = ingredient.ShouldBeAddedToShoppingCart
		};
		
		_ingredientSearch = ingredient.Name;
		_dropdownOpen = false;
	}

	private async Task OnDropdownBlur()
	{
		// Delay to allow click event to register before closing dropdown
		await Task.Delay(150);
		_dropdownOpen = false;
	}

	private void CancelEditName()
	{
		// Discard the scratch buffer; recipe.Name was never touched.
		_isEditingName = false;
		_editedName = string.Empty;
	}

	private async Task HandleIngredientSearchKeydown(KeyboardEventArgs e)
	{
		if (e.Key != "Enter")
			return;

		// Enter confirms the name — picking the catalog entry if there is one, creating it if
		// there is not. It does not submit; amount and unit still have to be filled in.
		await ResolveIngredientAsync();
		_dropdownOpen = false;
	}

}
