@page "/recipes/find"

@using Blazored.LocalStorage
@inject RecipeService RecipeService
@inject IngredientService IngredientService
@inject ILocalStorageService LocalStorage
@inject NavigationManager NavigationManager

<PageTitle>@UiText.FindRecipes.Title</PageTitle>

<div class="find-layout">
	<PageHeader Title="@UiText.FindRecipes.Title"
	            Subtitle="@UiText.FindRecipes.Subtitle"/>

	<div class="find-content">
		@* --- Left: ingredient list builder + settings --- *@
		<aside class="find-sidebar">
			<AppCard CssClass="find-panel">
				<Header>
					<span class="find-panel__title">
						<i class="bi bi-basket2" aria-hidden="true"></i> @UiText.FindRecipes.MyIngredients
					</span>
				</Header>
				<Body>
				<div class="find-combo">
					<div class="find-add">
						<input type="text"
						       class="form-control"
						       placeholder="@UiText.FindRecipes.AddPlaceholder"
						       aria-label="@UiText.FindRecipes.AddAriaLabel"
						       autocomplete="off"
						       role="combobox"
						       aria-expanded="@_showSuggestions"
						       value="@_searchValue"
						       @oninput="OnQueryInput"
						       @onfocus="ShowSuggestions"
						       @onblur="OnInputBlur"
						       @onkeydown="OnInputKeyDown"/>
					</div>

					@* No "+" button and no free-text option: a term that is not a catalog entry has
					   no id, and matching runs on ids only, so it could never match anything. *@
					@if (_showSuggestions)
					{
						List<IngredientDto> options = FilteredSuggestions;
						if (options.Count > 0 || !string.IsNullOrWhiteSpace(_searchValue))
						{
							<ul class="find-combo__menu" role="listbox">
								@for (int i = 0; i < options.Count; i++)
								{
									int index = i;
									IngredientDto option = options[i];
									<li role="option"
									    aria-selected="@(index == _activeIndex)"
									    class="find-combo__option @(index == _activeIndex ? "is-active" : null)"
									    @onmousedown:preventDefault="true"
									    @onmousedown="() => SelectSuggestion(option)">
										<i class="bi bi-plus-circle" aria-hidden="true"></i>
										<span>@option.Name</span>
									</li>
								}
								@if (options.Count == 0)
								{
									<li class="find-combo__option find-combo__option--empty">
										<i class="bi bi-search" aria-hidden="true"></i>
										<span>@UiText.FindRecipes.NoIngredientFound</span>
									</li>
								}
							</ul>
						}
					}
				</div>

				@if (_prefs.IngredientIds.Count == 0)
				{
					<p class="find-hint fh-muted">
						@UiText.FindRecipes.NothingAdded
					</p>
				}
				else
				{
					<div class="find-chips">
						@foreach (IngredientDto ingredient in SelectedIngredients)
						{
							Guid ingredientId = ingredient.Id;
							<span class="find-chip">
									<span class="find-chip__label" title="@ingredient.Name">@ingredient.Name</span>
									<button type="button"
									        class="find-chip__remove"
									        aria-label="@UiText.FindRecipes.RemoveAriaLabel(ingredient.Name)"
									        @onclick="() => RemoveIngredient(ingredientId)">
										<i class="bi bi-x" aria-hidden="true"></i>
									</button>
								</span>
						}
					</div>
					<AppButton Variant="ButtonVariant.Link"
					           Size="ButtonSize.Small"
					           Icon="trash"
					           CssClass="find-clear"
					           OnClick="ClearIngredients">
						@UiText.FindRecipes.ClearAll
					</AppButton>
				}
				</Body>
			</AppCard>

			<AppCard CssClass="find-panel">
				<Header>
					<span class="find-panel__title">
						<i class="bi bi-sliders" aria-hidden="true"></i> @UiText.FindRecipes.Options
					</span>
				</Header>
				<Body>
				<EditForm Model="_prefs" FormName="find-options">
					<SelectField TValue="MatchMode"
					             Label="@UiText.FindRecipes.MatchLabel"
					             @bind-Value="_prefs.Mode"
					             @bind-Value:after="PersistAndRecompute">
						<option value="@nameof(MatchMode.Any)">@UiText.FindRecipes.MatchAny</option>
						<option value="@nameof(MatchMode.All)">@UiText.FindRecipes.MatchAll</option>
					</SelectField>

					<SelectField TValue="SortMode"
					             Label="@UiText.FindRecipes.SortLabel"
					             @bind-Value="_prefs.Sort"
					             @bind-Value:after="PersistAndRecompute">
						<option value="@nameof(SortMode.MostMatches)">@UiText.FindRecipes.SortMostMatches</option>
						<option value="@nameof(SortMode.Name)">@UiText.FindRecipes.SortName</option>
					</SelectField>

					<label class="find-check">
						<input type="checkbox"
						       class="form-check-input"
						       checked="@_prefs.Highlight"
						       @onchange="OnHighlightChanged"/>
						<span>@UiText.FindRecipes.HighlightLabel</span>
					</label>
				</EditForm>
				</Body>
			</AppCard>
		</aside>

		@* --- Right: results --- *@
		<section class="find-results">
			@if (_allRecipes == null)
			{
				<LoadingSpinner Label="@UiText.FindRecipes.Loading"/>
			}
			else if (_prefs.IngredientIds.Count == 0)
			{
				<EmptyState Icon="basket"
				            Title="@UiText.FindRecipes.NoIngredientsTitle"
				            Message="@UiText.FindRecipes.NoIngredientsMessage"/>
			}
			else if (_results.Count == 0)
			{
				<EmptyState Icon="search"
				            Title="@UiText.FindRecipes.NoMatchesTitle"
				            Message="@NoResultsMessage"/>
			}
			else
			{
				<p class="find-count fh-muted">
					@UiText.FindRecipes.Found(_results.Count)
				</p>
				<div class="fh-grid">
					@foreach (RecipeMatch match in _results)
					{
						<div class="card find-card">
							<div class="find-card__header">
								<h3 class="fh-card-title" title="@match.Recipe.Name">@match.Recipe.Name</h3>
							</div>
							<div class="badge-container">
								<Badge
									Variant="Badge.BadgeVariant.Accent"
									Icon="check2-circle">
									@match.SelectedIngredientIds.Count / @_prefs.IngredientIds.Count
								</Badge>
							</div>
							<div class="card-body">
								<ul class="find-ingredients">
									@foreach (RecipeItemDto ingredient in match.Recipe.Ingredients)
									{
										bool hit = _prefs.Highlight && match.IsIngredientSelected(ingredient.IngredientId);
										<li class="@(hit ? "find-ingredients__hit" : string.Empty)">
											@if (hit) { <i class="bi bi-check-lg" aria-hidden="true"></i> }
											<span>@ingredient.Ingredient.Name</span>
											<span class="fh-muted find-ingredients__amount">
												@ingredient.Amount.ToFormattedString() @UiText.AmountTypes.Label(ingredient.IngredientAmount)
											</span>
										</li>
									}
								</ul>
							</div>
							<div class="find-card__footer">
								@if (match.MissingCount == 0)
								{
									<span class="fh-muted find-card__note">
										<i class="bi bi-bag-check" aria-hidden="true"></i> @UiText.FindRecipes.HaveEverything
									</span>
								}
								else
								{
									<span class="fh-muted find-card__note">
										@UiText.FindRecipes.StillNeeded(match.MissingCount)
									</span>
								}
								<AppButton Variant="ButtonVariant.OutlineSecondary"
								           Size="ButtonSize.Small"
								           Icon="box-arrow-up-right"
								           OnClick="() => OpenRecipe(match.Recipe.Id)">
									@UiText.Common.Open
								</AppButton>
							</div>
						</div>
					}
				</div>
			}
		</section>
	</div>
</div>

@code {
	private List<RecipeDto>? _allRecipes;

	// The whole catalog, not just its names: a selection is a catalog id, and only the id is
	// ever compared against a recipe line. Names are for display.
	private List<IngredientDto> _catalog = [];
	private Dictionary<Guid, IngredientDto> _catalogById = [];

	private List<RecipeMatch> _results = [];
	private string _searchValue = string.Empty;
	private bool _showSuggestions;
	private int _activeIndex = -1;

	private Preferences _prefs = new();

	protected override async Task OnInitializedAsync()
	{
		_prefs = await LocalStorage.GetItemAsync<Preferences>(WebConstants.Storage.PantryPreferences) ?? new Preferences();

		_allRecipes = await RecipeService.GetAllRecipesAsync(withIngredients: true)
			.OrDefault(new List<RecipeDto>());

		// The catalog powers both the type-ahead and the chips; failure here is non-fatal.
		var ingredients = await IngredientService.GetAllIngredientsAsync();
		if (ingredients.Success && ingredients.Data is not null)
		{
			_catalog = [..ingredients.Data.Where(i => !string.IsNullOrWhiteSpace(i.Name))];
			_catalogById = _catalog.ToDictionary(i => i.Id);
		}

		await ReconcileSelectionWithCatalogAsync();

		Recompute();
	}

	/// <summary>
	/// Brings the stored selection in line with the catalog we just loaded. Two things can be
	/// stale: a list saved before this page matched on ids (names, resolved here once and
	/// rewritten as ids), and ids whose catalog entry has since been deleted (dropped, because
	/// nothing can be shown or matched for them). Only writes when something actually changed.
	/// </summary>
	private async Task ReconcileSelectionWithCatalogAsync()
	{
		if (_catalog.Count == 0)
			return;

		var changed = _prefs.IngredientIds.RemoveAll(id => !_catalogById.ContainsKey(id)) > 0;

		if (changed)
			await LocalStorage.SetItemAsync(WebConstants.Storage.PantryPreferences, _prefs);
	}

	/// <summary>The selected catalog entries, in the order they were added.</summary>
	private IEnumerable<IngredientDto> SelectedIngredients =>
		_prefs.IngredientIds.Where(_catalogById.ContainsKey).Select(id => _catalogById[id]);

	/// <summary>
	/// Type-ahead suggestions: still a case-insensitive substring search, so "ui" keeps turning up
	/// Bouillon and Groentebouillon, but ranked so the ingredient you actually typed comes first.
	/// Plain alphabetical order buried "Ui" below every word that merely contains those letters.
	/// All matches are returned — the menu scrolls.
	/// </summary>
	private List<IngredientDto> FilteredSuggestions
	{
		get
		{
			string query = _searchValue.Trim();

			IEnumerable<IngredientDto> candidates = _catalog.Where(i => !_prefs.IngredientIds.Contains(i.Id));

			if (query.Length == 0)
				return candidates.OrderBy(i => i.Name, StringComparer.OrdinalIgnoreCase)
					.ToList();

			return candidates.Where(i => i.Name.Contains(query, StringComparison.OrdinalIgnoreCase))
				.OrderBy(i => Rank(i.Name, query))
				.ThenBy(i => i.Name.Length)
				.ThenBy(i => i.Name, StringComparer.OrdinalIgnoreCase)
				.ToList();
		}
	}

	/// <summary>
	/// How well a name answers the query: exact, then starts-with, then a word inside the name
	/// starting with it ("Rode ui"), then a match anywhere ("Bouillon"). Lower sorts first.
	/// </summary>
	private static int Rank(string name, string query)
	{
		if (name.Trim().Equals(query, StringComparison.OrdinalIgnoreCase))
			return 0;

		if (name.StartsWith(query, StringComparison.OrdinalIgnoreCase))
			return 1;

		foreach (string word in name.Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
		{
			if (word.StartsWith(query, StringComparison.OrdinalIgnoreCase))
				return 2;
		}

		return 3;
	}

	private string NoResultsMessage => _prefs.Mode == MatchMode.All ? UiText.FindRecipes.NoMatchesAll : UiText.FindRecipes.NoMatchesAny;

	private void ShowSuggestions() => _showSuggestions = true;

	private void OnQueryInput(ChangeEventArgs e)
	{
		_searchValue = e.Value?.ToString() ?? string.Empty;
		_showSuggestions = true;
		_activeIndex = -1;
	}

	private void OnInputBlur()
	{
		// Options select on mousedown with preventDefault, so they never steal focus from the input.
		// A real blur therefore means focus left the combobox entirely, so the menu can close.
		_showSuggestions = false;
		_activeIndex = -1;
	}

	private async Task OnInputKeyDown(KeyboardEventArgs e)
	{
		List<IngredientDto> options = FilteredSuggestions;

		switch (e.Key)
		{
			case "ArrowDown":
				_showSuggestions = true;
				if (options.Count > 0)
					_activeIndex = (_activeIndex + 1) % options.Count;
			break;
			case "ArrowUp":
				if (options.Count > 0)
					_activeIndex = _activeIndex <= 0 ? options.Count - 1 : _activeIndex - 1;
			break;
			case "Enter":
				// No fallback to the typed text: only a catalog entry carries an id, and without
				// one there is nothing to match on. Enter on nothing selected takes the best
				// suggestion, which after ranking is the exact name whenever there is one.
				if (_activeIndex >= 0 && _activeIndex < options.Count)
					await SelectSuggestion(options[_activeIndex]);
				else if (options.Count > 0 && _searchValue.Trim().Length > 0)
					await SelectSuggestion(options[0]);
			break;
			case "Escape":
				_showSuggestions = false;
				_activeIndex = -1;
			break;
		}
	}

	private async Task SelectSuggestion(IngredientDto ingredient)
	{
		if (!_prefs.IngredientIds.Contains(ingredient.Id))
			_prefs.IngredientIds.Add(ingredient.Id);

		_searchValue = string.Empty;
		_activeIndex = -1;
		// Keep the menu open so several ingredients can be added in a row — the input keeps focus
		// because option mousedown suppresses blur.
		_showSuggestions = true;
		await PersistAndRecompute();
	}

	private async Task RemoveIngredient(Guid ingredientId)
	{
		_prefs.IngredientIds.Remove(ingredientId);
		await PersistAndRecompute();
	}

	private async Task ClearIngredients()
	{
		_prefs.IngredientIds.Clear();
		await PersistAndRecompute();
	}

	private async Task OnHighlightChanged(ChangeEventArgs e)
	{
		_prefs.Highlight = e.Value is true;
		await LocalStorage.SetItemAsync(WebConstants.Storage.PantryPreferences, _prefs);
		// Highlight only affects rendering, no re-match needed.
	}

	private void OpenRecipe(Guid recipeId)
	{
		NavigationManager.NavigateTo($"/recipe/{recipeId}");
	}

	private async Task PersistAndRecompute()
	{
		await LocalStorage.SetItemAsync(WebConstants.Storage.PantryPreferences, _prefs);
		Recompute();
	}

	/// <summary>
	/// Matches every recipe against the current selection, then filters and sorts according to the
	/// chosen options. A recipe line counts as a match only when it points at the same catalog
	/// entry — never when its name merely looks alike. Names were compared with Contains before,
	/// which handed "Linguine" a green tick for "ui"; even exact name equality would still break
	/// on a rename, so the id is the only thing read here.
	/// </summary>
	private void Recompute()
	{
		if (_allRecipes is null)
			return;

		var selected = _prefs.IngredientIds.ToHashSet();
		var matches = new List<RecipeMatch>();

		foreach (RecipeDto recipe in _allRecipes)
		{
			List<RecipeItemDto> recipeIngredients = recipe.Ingredients;
			HashSet<Guid> matchedIngredientIds = [];
			
			foreach (RecipeItemDto ri in recipeIngredients)
			{
				var ingredientId = ri.IngredientId;
				if (selected.Contains(ingredientId))
				{
					matchedIngredientIds.Add(ingredientId);
				}
			}
			
			matches.Add(new RecipeMatch(recipe, matchedIngredientIds));

		}

		IEnumerable<RecipeMatch> filtered = _prefs.Mode == MatchMode.All 
			? matches.Where(m => m.SelectedIngredientIds.Count == selected.Count && selected.Count > 0)
			: matches.Where(m => m.SelectedIngredientIds.Count > 0);

		_results = [..Sort(filtered)];
	}

	private IEnumerable<RecipeMatch> Sort(IEnumerable<RecipeMatch> source) => _prefs.Sort switch
		{
			SortMode.MostMatches => source.OrderByDescending(m => m.SelectedIngredientIds.Count)
				.ThenBy(m => m.MissingCount)
				.ThenBy(m => m.Recipe.Name),
			_ => source.OrderBy(m => m.Recipe.Name)
		};

	public enum MatchMode
	{
		Any,
		All
	}

	public enum SortMode
	{
		MostMatches,
		Name
	}

	public sealed class Preferences
	{
		/// <summary>Catalog ids, in the order they were picked.</summary>
		public List<Guid> IngredientIds { get; set; } = [];
		public MatchMode Mode { get; set; } = MatchMode.Any;
		public SortMode Sort { get; set; } = SortMode.MostMatches;
		public bool Highlight { get; set; } = true;
	}

	public sealed record RecipeMatch(RecipeDto Recipe, HashSet<Guid> SelectedIngredientIds)
	{
		public bool IsIngredientSelected(Guid ingredientId) => SelectedIngredientIds.Contains(ingredientId);
		public int MissingCount => Recipe.Ingredients.Count - SelectedIngredientIds.Count;
	}
}
