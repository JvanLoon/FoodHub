@page "/recipes"

@using Blazored.LocalStorage
@using FoodCalc.Web.Constants
@inject IJSRuntime JS
@inject RecipeService recipeService
@inject ILocalStorageService LocalStorage
@inject MessageService MessageService
@inject NavigationManager NavigationManager
@inject AuthStateService AuthStateService

<PageTitle>@UiText.Recipes.Title</PageTitle>

<div class="recipes-layout">
	<div class="recipes-header">
		<PageHeader Title="@UiText.Recipes.Title" Subtitle="@UiText.Recipes.Subtitle">
			<SearchBox Placeholder="@UiText.Recipes.SearchPlaceholder" Value="@searchTerm" ValueChanged="OnSearchChanged"/>
			@* Also in the sidebar, but this is where someone browsing recipes looks for it. *@
			<AppButton Variant="ButtonVariant.Primary" Icon="plus-circle"
			           OnClick="AddRecipe">
				@UiText.Nav.AddRecipe
			</AppButton>
			<AppButton Variant="ButtonVariant.OutlineSecondary" Icon="cart3"
			           Disabled="@(!SelectedRecipeIds.Any())"
			           OnClick="OpenAggregatedIngredientsPage">
				@UiText.Recipes.GenerateShoppingList
			</AppButton>
		</PageHeader>
	</div>

	<div class="recipes-body">
		@if (pagedResult == null)
		{
			<LoadingSpinner Label="@UiText.Recipes.Loading"/>
		}
		else if (pagedResult.Items.Any())
		{
			<div class="fh-grid">
				@foreach (RecipeDto recipe in pagedResult.Items)
				{
					<RecipeCard Title="@(recipe.Name ?? string.Empty)"
					            ShowActions="@CanEdit(recipe)"
					            OnOpen="() => OpenRecipe(recipe.Id)"
					            Selected="@SelectedRecipeIds.Contains(recipe.Id)"
					            OnToggle="() => ToggleRecipeSelection(recipe.Id, !SelectedRecipeIds.Contains(recipe.Id))"
					            OnEdit="() => EditRecipe(recipe.Id)"
					            OnDelete="() => DeleteRecipe(recipe.Id)">
						@* Only ever reached for your own recipes — the API does not return
						   anyone else's unapproved work — so this reads as "mine, not public yet". *@
						@if (!recipe.IsReviewed)
						{
							<div class="recipe-pending">
								<Badge Variant="Badge.BadgeVariant.Warning" Icon="hourglass-split">
									@UiText.Recipes.AwaitingApproval
								</Badge>
							</div>
						}
						<p class="ingredients-label">@UiText.Recipes.IngredientsLabel</p>
						<ul class="ingredients-list">
							@if (recipe.Ingredients != null)
							{
								foreach (RecipeItemDto ingredient in recipe.Ingredients)
								{
									<li>
										<span>@ingredient.Name</span>
										<span
											class="fh-muted">@ingredient.Amount.ToFormattedString() @UiText.AmountTypes.Label(ingredient.IngredientAmount)</span>
									</li>
								}
							}
						</ul>
					</RecipeCard>
				}
			</div>
		}
		else
		{
			<EmptyState Icon="journal-x" Title="@UiText.Recipes.EmptyTitle"
			            Message="@UiText.Recipes.EmptyMessage"/>
		}
	</div>

	<div class="recipes-footer">
		@if (pagedResult != null && pagedResult.Items.Any())
		{
			<Paginator TotalCount="pagedResult.TotalCount"
			           Page="pagedResult.Page"
			           PageSize="pagedResult.PageSize"
			           PageChanged="OnPageChanged"
			           PageSizeChanged="OnPageSizeChanged"/>
		}
	</div>
</div>

<ConfirmDialog @ref="confirmDialog"/>

@code {
	private PagedResultDto<RecipeDto>? pagedResult;
	private int currentPage = 1;
	private int pageSize = 10;
	private string searchTerm = string.Empty;
	private HashSet<Guid> SelectedRecipeIds = new();
	private List<RecipeItemDto> AggregatedIngredients = new();
	private ConfirmDialog? confirmDialog;
	private bool canEditAny;
	private string? currentUserId;

	protected override async Task OnInitializedAsync()
	{
		try
		{
			canEditAny = await AuthStateService.CanEditAnyContentAsync();
			currentUserId = await AuthStateService.GetUserIdAsync();
		}
		catch
		{
			canEditAny = false;
			currentUserId = null;
		}

		await LoadRecipesAsync();
	}

	/// <summary>
	/// Whether to offer Edit/Delete on a card: staff (Admin or Moderator) for anything, or the
	/// recipe's author for their own. Mirrors the server's rule — which re-checks on every
	/// write, so this only decides what to render.
	/// </summary>
	private bool CanEdit(RecipeDto recipe) =>
		canEditAny || (!string.IsNullOrEmpty(currentUserId) && recipe.CreatedByUserId == currentUserId);

	private async Task LoadRecipesAsync()
	{
		pagedResult = await recipeService.GetPagedRecipesAsync(currentPage, pageSize, searchTerm)
			.OrDefault(new PagedResultDto<RecipeDto>());
	}

	private async Task OnPageChanged(int page)
	{
		currentPage = page;
		await LoadRecipesAsync();
	}

	private async Task OnPageSizeChanged(int size)
	{
		pageSize = size;
		currentPage = 1;
		await LoadRecipesAsync();
	}

	private async Task OnSearchChanged(string value)
	{
		searchTerm = value;
		currentPage = 1;
		await LoadRecipesAsync();
	}

	private async Task OpenAggregatedIngredientsPage()
	{
		AggregateIngredients();
		await LocalStorage.SetItemAsync(WebConstants.Storage.AggregatedIngredients, AggregatedIngredients);
		await JS.InvokeVoidAsync("window.open", "/aggregated-ingredients", "_blank");
		AggregatedIngredients = new();
	}

	private void ToggleRecipeSelection(Guid recipeId, bool? isChecked)
	{
		if (isChecked == true)
			SelectedRecipeIds.Add(recipeId);
		else
			SelectedRecipeIds.Remove(recipeId);
	}

	private void AggregateIngredients()
	{
		var ingredientDict = new Dictionary<(string Name, IngredientAmountTypeDto AmountType), RecipeItemDto>();

		foreach (var recipe in (pagedResult?.Items ?? []).Where(r => SelectedRecipeIds.Contains(r.Id)))
		{
			if (recipe.Ingredients == null) continue;

			foreach (var ri in recipe.Ingredients)
			{
				if (ri.ShouldBeAddedToShoppingCart)
				{
					var key = (ri.Name.ToLowerInvariant(), ri.IngredientAmount);
					if (ingredientDict.TryGetValue(key, out var existing)) { existing.Amount += ri.Amount; }
					else
					{
						// Clone to avoid mutating original
						ingredientDict[key] = new RecipeItemDto
						{
							Name = ri.Name,
							IngredientAmount = ri.IngredientAmount,
							Amount = ri.Amount,
							ShouldBeAddedToShoppingCart = ri.ShouldBeAddedToShoppingCart
						};
					}
				}
			}
		}

		AggregatedIngredients = ingredientDict.Values.OrderBy(i => i.Name)
			.ToList();
	}

	private void AddRecipe() => NavigationManager.NavigateTo("/recipes/create");

	private void EditRecipe(Guid recipeId)
	{
		NavigationManager.NavigateTo($"/recipes/edit/{recipeId}");
	}

	private void OpenRecipe(Guid recipeId)
	{
		NavigationManager.NavigateTo($"/recipe/{recipeId}");
	}

	private async Task DeleteRecipe(Guid recipeId)
	{
		var confirmed = confirmDialog is not null && await confirmDialog.ShowAsync(UiText.Recipes.DeleteTitle, UiText.Recipes.DeleteMessage, UiText.Common.Delete, danger: true);
		if (!confirmed)
			return;

		await recipeService.DeleteRecipe(recipeId)
			.OnSuccess(async () =>
			{
				await LoadRecipesAsync();
				StateHasChanged();
			}, WebConstants.Messages.Recipe.Deleted)
			.OnFailure();
	}

}
