@page "/recipe/{RecipeId:guid}"

@inject RecipeService RecipeService
@inject IJSRuntime JS

<PageTitle>@(recipe?.Name ?? UiText.RecipeDetail.Fallback)</PageTitle>

<div class="fh-stack">
	<PageHeader Title="@(recipe?.Name ?? UiText.RecipeDetail.Fallback)" Subtitle="@UiText.RecipeDetail.Subtitle">
		@* Only once the recipe has loaded — the picker needs its id and name. *@
		@if (recipe is not null)
		{
			<AppButton Variant="ButtonVariant.Accent" Icon="calendar-plus" OnClick="OpenCalendarAsync">
				@UiText.Calendar.AddToCalendar
			</AppButton>
		}
		<AppButton Variant="ButtonVariant.OutlineSecondary" Icon="arrow-left" OnClick="GoBack">@UiText.Common.Back</AppButton>
	</PageHeader>

	@if (loading)
	{
		<LoadingSpinner Label="@UiText.RecipeDetail.Loading"/>
	}
	else if (recipe is null)
	{
		<EmptyState Icon="journal-x" Title="@UiText.RecipeDetail.NotFoundTitle"
		            Message="@UiText.RecipeDetail.NotFoundMessage"/>
	}
	else
	{
		<div class="recipe-view">

			<AppCard CssClass="recipe-view__card">
				<h2 class="fh-subheading">@UiText.RecipeDetail.Ingredients</h2>
				@if (recipe.Ingredients.Count > 0)
				{
					<ul class="recipe-view__ingredients">
						@foreach (var ingredient in recipe.Ingredients)
						{
							<li>
								<span>@ingredient.Name</span>
								<span class="fh-muted">
								    @ingredient.Amount.ToFormattedString() @UiText.AmountTypes.Label(ingredient.IngredientAmount)
							    </span>
							</li>
						}
					</ul>
				}
				else { <p class="fh-muted">@UiText.RecipeDetail.NoIngredients</p> }
			</AppCard>
		</div>
	}
</div>

<AddToCalendarModal @ref="calendarModal"/>

@code {

	[Parameter]
	public Guid RecipeId { get; set; }

	private RecipeDto? recipe;
	private bool loading = true;
	private AddToCalendarModal? calendarModal;

	private Task OpenCalendarAsync() =>
		recipe is null || calendarModal is null
			? Task.CompletedTask
			: calendarModal.ShowAsync(recipe.Id, recipe.Name ?? string.Empty);

	protected override async Task OnInitializedAsync()
	{
		var result = await RecipeService.GetRecipeByIdAsync(RecipeId);
		if (result.Success)
			recipe = result.Data;
		loading = false;
	}

	private async Task GoBack() => await JS.InvokeVoidAsync("history.back");
}
