@page "/calendar"

@inject MealPlanService MealPlanService
@inject RecipeService RecipeService
@inject IngredientService IngredientService
@inject MessageService MessageService
@inject NavigationManager Navigation

<PageTitle>@UiText.Calendar.Title</PageTitle>

<div class="cal-layout">
	<div class="cal-header">
		<PageHeader Title="@UiText.Calendar.Title" Subtitle="@UiText.Calendar.Subtitle">
			<div class="cal-toggle" role="tablist" aria-label="@UiText.Calendar.ViewAriaLabel">
				<button type="button" class="cal-toggle__btn @(_viewMode == View.Week ? "cal-toggle__btn--active" : "")"
				        role="tab" aria-selected="@(_viewMode == View.Week)" @onclick="() => _viewMode = View.Week">
					<i class="bi bi-calendar-week" aria-hidden="true"></i> @UiText.Calendar.Week
				</button>
				<button type="button"
				        class="cal-toggle__btn @(_viewMode == View.Month ? "cal-toggle__btn--active" : "")"
				        role="tab" aria-selected="@(_viewMode == View.Month)" @onclick="() => _viewMode = View.Month">
					<i class="bi bi-calendar-month" aria-hidden="true"></i> @UiText.Calendar.Month
				</button>
			</div>
			<AppButton Variant="ButtonVariant.Primary" Icon="shuffle"
			           Disabled="@(_selectedDates.Count < 2)"
			           OnClick="OpenRandomize">
				@UiText.Calendar.Randomize @(_selectedDates.Count >= 2 ? $"({_selectedDates.Count})" : "")
			</AppButton>
			@if (_selectedDates.Count > 0)
			{
				<AppButton Variant="ButtonVariant.OutlineSecondary" Icon="x-circle"
				           OnClick="ClearSelection">
					@UiText.Calendar.ClearSelection
				</AppButton>
			}
		</PageHeader>
	</div>

	@if (_loading)
	{
		<LoadingSpinner Label="@UiText.Calendar.Loading"/>
	}
	else
	{
		<div class="cal-views">
			@if (_viewMode == View.Week)
			{
				@* ---------- Week view ---------- *@
				<section class="cal-panel">
					<div class="cal-panel__head">
						<h2 class="fh-subheading">@UiText.Calendar.Week</h2>
						<div class="cal-nav">
							<IconButton Icon="chevron-left" Title="@UiText.Calendar.PreviousWeek" OnClick="PrevWeek"/>
							<span class="cal-nav__label">@WeekLabel</span>
							<IconButton Icon="chevron-right" Title="@UiText.Calendar.NextWeek" OnClick="NextWeek"/>
						</div>
					</div>
					<div class="cal-week">
						@foreach (var day in WeekDays)
						{
							<CalDay Day="day" Compact="false"
							        Selected="_selectedDates.Contains(day)"
							        Entries="EntriesFor(day)"
							        OnSelect="() => ToggleSelect(day)"
							        OnAdd="() => OpenAdd(day)"
							        OnRemove="RemoveEntryAsync"
							        OnOpen="OpenRecipe"/>
						}
					</div>
				</section>
			}
			else
			{
				@* ---------- Month view ---------- *@
				<section class="cal-panel">
					<div class="cal-panel__head">
						<h2 class="fh-subheading">@UiText.Calendar.Month</h2>
						<div class="cal-nav">
							<IconButton Icon="chevron-left" Title="@UiText.Calendar.PreviousMonth" OnClick="PrevMonth"/>
							<span class="cal-nav__label">@MonthLabel</span>
							<IconButton Icon="chevron-right" Title="@UiText.Calendar.NextMonth" OnClick="NextMonth"/>
						</div>
					</div>
					<div class="cal-month">
						@foreach (var dow in DayOfWeekHeaders)
						{
							<div class="cal-month__dow">@dow</div>
						}
						@foreach (var day in MonthGridDays)
						{
							<CalDay Day="day" Compact="true"
							        Selected="_selectedDates.Contains(day)"
							        IsOtherMonth="day.Month != _monthAnchor.Month"
							        Entries="EntriesFor(day)"
							        OnSelect="() => ToggleSelect(day)"
							        OnAdd="() => OpenAdd(day)"
							        OnRemove="RemoveEntryAsync"
							        OnOpen="OpenRecipe"/>
						}
					</div>
				</section>
			}
		</div>
	}
</div>

@* ---------- Add-recipe picker ---------- *@
<Modal @bind-Visible="_addModalVisible" Title="@AddModalTitle">
	<SearchBox Placeholder="@UiText.Calendar.SearchRecipes" Value="@_recipeSearch" ValueChanged="OnRecipeSearchChanged"/>
	<div class="cal-picker">
		@foreach (var recipe in FilteredRecipes)
		{
			<button type="button" class="cal-picker__item" @onclick="() => AddRecipeAsync(recipe)">
				<i class="bi bi-egg-fried" aria-hidden="true"></i>
				<span>@recipe.Name</span>
				<i class="bi bi-plus-lg cal-picker__add"></i>
			</button>
		}
		@if (!FilteredRecipes.Any())
		{
			<EmptyState Icon="journal-x" Title="@UiText.Calendar.NoRecipesTitle"
			            Message="@UiText.Calendar.NoRecipesMessage"/>
		}
	</div>
</Modal>

@* ---------- Randomize popup ---------- *@
<Modal @bind-Visible="_randomizeModalVisible" Title="@UiText.Calendar.RandomizeTitle"
       BodyClass="fh-modal__body--allow-overflow">
	<ChildContent>
		<p class="fh-muted">
			@UiText.Calendar.RandomizeIntro(_selectedDates.Count)
		</p>

		<div class="fh-field">
			<label class="fh-label">@UiText.Calendar.WantedIngredients <span class="fh-muted">@UiText.Calendar.Optional</span></label>
			@if (_wantedIngredients.Any())
			{
				<div class="cal-chips">
					@foreach (var ing in _wantedIngredients)
					{
						<span class="cal-chip">
                        @ing
							<button type="button" class="cal-chip__x" @onclick="() => RemoveIngredient(ing)"
							        aria-label="@UiText.Calendar.RemoveRecipe">
                            <i class="bi bi-x"></i>
                        </button>
                    </span>
					}
				</div>
			}
			<div class="cal-combo">
				<div class="cal-combo__control">
					<input class="cal-input" placeholder="@UiText.Calendar.IngredientPlaceholder"
					       @bind="_ingredientDraft" @bind:event="oninput"
					       @onfocus="() => _ingredientMenuOpen = true"
					       @onkeydown="OnIngredientKeyDown"/>
					<button type="button" class="cal-combo__toggle" @onclick="ToggleIngredientMenu"
					        aria-label="@UiText.Calendar.ToggleIngredientList">
						<i class="bi bi-chevron-@(_ingredientMenuOpen ? "up" : "down")"></i>
					</button>
				</div>
				@if (_ingredientMenuOpen)
				{
					<ul class="cal-combo__menu">
						@foreach (var name in IngredientOptions)
						{
							<li>
								<button type="button" class="cal-combo__item"
								        @onclick="() => SelectIngredient(name)">@name</button>
							</li>
						}
						@if (!IngredientOptions.Any())
						{
							<li class="cal-combo__empty">
								@(_allIngredientNames.Count == 0 ? UiText.Calendar.NoIngredientsAvailable : UiText.Calendar.NoMatches)
							</li>
						}
					</ul>
				}
			</div>
		</div>

		@* Recipes-per-day: wired up but intentionally hidden for now (defaults to 1). *@
		<div class="fh-field" style="display:none;">
			<label class="fh-label">@UiText.Calendar.RecipesPerDay</label>
			<input class="cal-input" type="number" min="1" max="20" @bind="_recipesPerDay" disabled/>
		</div>

		<label class="cal-check">
			<input type="checkbox" @bind="_uniqueOnly"/>
			<span>@UiText.Calendar.UniqueOnlyLabel</span>
		</label>

		<label class="cal-check">
			<input type="checkbox" @bind="_overwriteDays"/>
			<span>@UiText.Calendar.OverwriteLabel</span>
		</label>
	</ChildContent>

	<Footer>
		<AppButton Variant="ButtonVariant.OutlineSecondary" OnClick="CloseRandomize">@UiText.Common.Cancel</AppButton>
		<AppButton Variant="ButtonVariant.Primary" Icon="shuffle" Disabled="@_randomizing" OnClick="RunRandomizeAsync">
			@(_randomizing ? UiText.Calendar.Randomizing : UiText.Calendar.Randomize)
		</AppButton>
	</Footer>
</Modal>

@code {
	private bool _loading = true;

	private enum View
	{
		Week,
		Month
	}

	private View _viewMode = View.Week;

	// Anchors for the two views.
	private DateOnly _weekAnchor = DateOnly.FromDateTime(DateTime.Today);
	private DateOnly _monthAnchor = new(DateTime.Today.Year, DateTime.Today.Month, 1);

	// date -> entries planned for that day (covers the currently fetched range).
	private Dictionary<DateOnly, List<MealPlanEntryDto>> _entriesByDay = new();

	private readonly HashSet<DateOnly> _selectedDates = new();

	private List<RecipeDto> _allRecipes = new();

	// Add picker state.
	private bool _addModalVisible;
	private DateOnly _addTargetDate;
	private string _recipeSearch = string.Empty;

	// Randomize state.
	private bool _randomizeModalVisible;
	private bool _randomizing;
	private List<string> _wantedIngredients = new();
	private string _ingredientDraft = string.Empty;
	private int _recipesPerDay = 1;
	private bool _overwriteDays;

	// Variety is what people expect from "randomize", so it is on unless turned off.
	private bool _uniqueOnly = true;

	// All ingredient names from the DB, for the randomize dropdown.
	private List<string> _allIngredientNames = new();
	private bool _ingredientMenuOpen;

	private static string[] DayOfWeekHeaders => UiText.Calendar.DayHeaders;

	protected override async Task OnInitializedAsync()
	{
		var recipes = await RecipeService.GetAllRecipesAsync(withIngredients: false)
			.OrDefault(new List<RecipeDto>());
		_allRecipes = recipes.OrderBy(r => r.Name)
			.ToList();

		var ingredients = await IngredientService.GetAllIngredientsAsync()
			.OrDefault(new List<IngredientDto>());
		_allIngredientNames = ingredients.Select(i => i.Name)
			.Where(n => !string.IsNullOrWhiteSpace(n))
			.Distinct(StringComparer.OrdinalIgnoreCase)
			.OrderBy(n => n)
			.ToList();

		await ReloadAsync();
		_loading = false;
	}

	// ---------- Range helpers ----------

	private DateOnly WeekStart => StartOfWeek(_weekAnchor);

	private IEnumerable<DateOnly> WeekDays => Enumerable.Range(0, 7)
		.Select(i => WeekStart.AddDays(i));

	private DateOnly MonthGridStart => StartOfWeek(_monthAnchor);

	private DateOnly MonthGridEnd
	{
		get
		{
			var lastOfMonth = _monthAnchor.AddMonths(1)
				.AddDays(-1);
			return StartOfWeek(lastOfMonth)
				.AddDays(6);
		}
	}

	private IEnumerable<DateOnly> MonthGridDays
	{
		get
		{
			var days = new List<DateOnly>();
			for (var d = MonthGridStart; d <= MonthGridEnd; d = d.AddDays(1))
				days.Add(d);
			return days;
		}
	}

	private static DateOnly StartOfWeek(DateOnly d)
	{
		// Monday-based week.
		int diff = ((int) d.DayOfWeek + 6) % 7;
		return d.AddDays(-diff);
	}

	private string WeekLabel => UiText.Calendar.WeekLabel(WeekStart);
	private string MonthLabel => UiText.Calendar.MonthLabel(_monthAnchor);
	private string AddModalTitle => UiText.Calendar.AddModalTitle(_addTargetDate);

	private IEnumerable<RecipeDto> FilteredRecipes = [];

	private List<MealPlanEntryDto> EntriesFor(DateOnly day) => _entriesByDay.TryGetValue(day, out var list) ? list : [];

	private async Task ReloadAsync()
	{
		var from = WeekStart < MonthGridStart ? WeekStart : MonthGridStart;
		var toWeek = WeekStart.AddDays(6);
		var to = toWeek > MonthGridEnd ? toWeek : MonthGridEnd;

		var result = await MealPlanService.GetRangeAsync(from, to)
			.OrDefault([]);
		_entriesByDay = result.GroupBy(e => e.Date)
			.ToDictionary(g => g.Key, g => g.ToList());
	}

	// ---------- Navigation ----------

	private async Task PrevWeek()
	{
		_weekAnchor = _weekAnchor.AddDays(-7);
		await ReloadAsync();
	}

	private async Task NextWeek()
	{
		_weekAnchor = _weekAnchor.AddDays(7);
		await ReloadAsync();
	}

	private async Task PrevMonth()
	{
		_monthAnchor = _monthAnchor.AddMonths(-1);
		await ReloadAsync();
	}

	private async Task NextMonth()
	{
		_monthAnchor = _monthAnchor.AddMonths(1);
		await ReloadAsync();
	}

	// ---------- Selection ----------

	private void ToggleSelect(DateOnly day)
	{
		if (!_selectedDates.Add(day))
			_selectedDates.Remove(day);
	}

	private void ClearSelection() => _selectedDates.Clear();

	// ---------- Add / remove ----------

	private void OpenAdd(DateOnly day)
	{
		_addTargetDate = day;
		_recipeSearch = string.Empty;
		_addModalVisible = true;
	}

	private void OnRecipeSearchChanged(string value)
	{
		_recipeSearch = value;

		FilteredRecipes = string.IsNullOrWhiteSpace(_recipeSearch) ? _allRecipes : _allRecipes.Where(r => r.Name.Contains(_recipeSearch, StringComparison.OrdinalIgnoreCase));
		StateHasChanged();
	}

	private void OpenRecipe(MealPlanEntryDto entry) => Navigation.NavigateTo($"/recipe/{entry.RecipeId}");

	private async Task AddRecipeAsync(RecipeDto recipe)
	{
		var result = await MealPlanService.AddAsync(_addTargetDate, recipe.Id);
		if (result.Success && result.Data is not null)
		{
			if (!_entriesByDay.TryGetValue(_addTargetDate, out var list))
			{
				list = [];
				_entriesByDay[_addTargetDate] = list;
			}

			list.Add(result.Data);
			_addModalVisible = false;
		}
		else { MessageService.ShowMessage(FirstError(result, WebConstants.Messages.Calendar.AddFailed), true, 6000); }
	}

	private async Task RemoveEntryAsync(MealPlanEntryDto entry)
	{
		var result = await MealPlanService.DeleteAsync(entry.Id);
		if (result.Success)
		{
			if (_entriesByDay.TryGetValue(entry.Date, out var list))
				list.RemoveAll(e => e.Id == entry.Id);
		}
		else { MessageService.ShowMessage(FirstError(result, WebConstants.Messages.Calendar.RemoveFailed), true, 6000); }
	}

	// ---------- Randomize ----------

	private void OpenRandomize()
	{
		if (_selectedDates.Count < 2) return;
		_wantedIngredients = [];
		_ingredientDraft = string.Empty;
		_ingredientMenuOpen = false;
		_recipesPerDay = 1;
		_overwriteDays = false;
		_uniqueOnly = true;
		_randomizeModalVisible = true;
	}

	private void CloseRandomize() => _randomizeModalVisible = false;

	// Ingredient names available to pick: everything not already chosen, filtered by what's typed.
	private IEnumerable<string> IngredientOptions => _allIngredientNames.Where(n => !_wantedIngredients.Contains(n, StringComparer.OrdinalIgnoreCase))
		.Where(n => string.IsNullOrWhiteSpace(_ingredientDraft) || n.Contains(_ingredientDraft.Trim(), StringComparison.OrdinalIgnoreCase));

	private void ToggleIngredientMenu() => _ingredientMenuOpen = !_ingredientMenuOpen;

	private void SelectIngredient(string name)
	{
		if (!_wantedIngredients.Contains(name, StringComparer.OrdinalIgnoreCase))
			_wantedIngredients.Add(name);
		_ingredientDraft = string.Empty;
		_ingredientMenuOpen = false;
	}

	private void OnIngredientKeyDown(KeyboardEventArgs e)
	{
		if (e.Key is not ("Enter" or ","))
			return;

		// Enter/comma: pick the first matching DB ingredient, else accept free text.
		var match = IngredientOptions.FirstOrDefault();
		if (match is not null)
			SelectIngredient(match);
		else
			AddIngredientDraft();
	}

	private void AddIngredientDraft()
	{
		var value = _ingredientDraft.Trim()
			.TrimEnd(',')
			.Trim();
		if (!string.IsNullOrEmpty(value) && !_wantedIngredients.Contains(value, StringComparer.OrdinalIgnoreCase)) { _wantedIngredients.Add(value); }

		_ingredientDraft = string.Empty;
		_ingredientMenuOpen = false;
	}

	private void RemoveIngredient(string ing) => _wantedIngredients.Remove(ing);

	private async Task RunRandomizeAsync()
	{
		// Fold any half-typed ingredient in before sending.
		AddIngredientDraft();

		_randomizing = true;
		var dayCount = _selectedDates.Count;
		var request = new RandomizeMealPlanDto
		{
			Dates = _selectedDates.ToList(),
			Ingredients = _wantedIngredients.ToList(),
			RecipesPerDay = _recipesPerDay,
			Overwrite = _overwriteDays,
			UniqueOnly = _uniqueOnly
		};

		var result = await MealPlanService.RandomizeAsync(request);
		_randomizing = false;

		if (result.Success)
		{
			await ReloadAsync();
			_randomizeModalVisible = false;
			var count = result.Data?.Count ?? 0;
			MessageService.ShowMessage(WebConstants.Messages.Calendar.Randomized(count, dayCount), false, 4000);
		}
		else { MessageService.ShowMessage(FirstError(result, WebConstants.Messages.Calendar.RandomizeFailed), true, 6000); }
	}

	private static string FirstError(ApiResult result, string fallback) => result.Errors.Count > 0 ? result.Errors[0] : fallback;
}
