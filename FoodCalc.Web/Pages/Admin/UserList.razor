@implements IAsyncDisposable
@inject AdminService AdminService
@inject AuthStateService AuthStateService

<div class="fh-stack">
	<div class="user-search">
		<SearchBox Placeholder="@UiText.Users.SearchPlaceholder" Value="@searchTerm" ValueChanged="OnSearchChanged"/>
	</div>

	@if (pagedResult == null)
	{
		<LoadingSpinner Label="@UiText.Users.Loading"/>
	}
	else if (pagedResult.Items.Any())
	{
		<ul class="user-list">
			@foreach (var user in pagedResult.Items)
			{
				<li>
					<a class="user-list__link" href="/admin/userroles/@user.Email">
						@* The badge is positioned against this wrapper, so it tracks the icon rather
						   than the row — the row grows a line taller for anyone who is offline. *@
						<span class="user-list__avatar">
							<i class="bi bi-person-circle" aria-hidden="true"></i>
							@* The cross wins over the dot on purpose. Signing in stamps presence
							   directly (that endpoint is anonymous), so a role-less account can
							   genuinely be "online" for three minutes while being unable to call
							   anything — a green dot there would be the least useful thing to say
							   about it. *@
							@if (!HasUsableRole(user))
							{
								<span class="user-list__badge user-list__badge--norole"
								      title="@UiText.Users.NoRole" aria-label="@UiText.Users.NoRole">
									<i class="bi bi-x" aria-hidden="true"></i>
								</span>
							}
							else if (user.IsOnline)
							{
								<span class="user-list__badge user-list__badge--online"
								      title="@UiText.Users.Online" aria-label="@UiText.Users.Online"></span>
							}
						</span>
						<span class="user-list__identity">
							<span class="user-list__email">@user.Email</span>
							@* Offline only: while they are online the dot already says so, and
							   "laatst actief zojuist" underneath it would just be noise. *@
							@if (!user.IsOnline)
							{
								<span class="user-list__last-active">@UiText.Users.LastActive(user.LastSeenUtc)</span>
							}
						</span>
					</a>
					@* Wrapped so the row's space-between keeps the buttons together on the
					   right instead of spreading them across the row. *@
					<div class="user-list__actions">
						@if (user.Id != currentUserId)
						{
							@if (user.Enabled)
							{
								<AppButton Variant="ButtonVariant.OutlineDanger" Size="ButtonSize.Small" Icon="person-fill-slash"
								           OnClick='async () => await ToggleUserAsync(user.Email, false)'/>
								
							}
							else
							{
								<AppButton Variant="ButtonVariant.OutlineSuccess" Size="ButtonSize.Small" Icon="person-check-fill" 
								           OnClick='async () => await ToggleUserAsync(user.Email, true)'/>
								
							}

							<AppButton Variant="ButtonVariant.Danger" Size="ButtonSize.Small" Icon="trash" OnClick='async () => await DeleteUserAsync(user.Email)'/>
							
						}
					</div>
				</li>
			}
		</ul>

		<Paginator TotalCount="pagedResult.TotalCount"
		           Page="pagedResult.Page"
		           PageSize="pagedResult.PageSize"
		           PageChanged="OnPageChanged"
		           PageSizeChanged="OnPageSizeChanged"/>
	}
	else
	{
		<EmptyState Icon="people" Title="@UiText.Users.Empty"/>
	}
</div>

<ConfirmDialog @ref="confirmDialog"/>

@code {
	private PagedResultDto<UserDto>? pagedResult;
	private int currentPage = 1;
	private int pageSize = 50;
	private string searchTerm = string.Empty;
	private ConfirmDialog? confirmDialog;
	private string? currentUserId;

	// Half the API's write throttle, so a user who has just gone online or offline is picked up
	// on the next tick or the one after — and the "laatst actief" lines, which are re-rendered
	// each tick, never drift more than a few seconds behind the minute they claim.
	private static readonly TimeSpan PollInterval = TimeSpan.FromSeconds(30);

	private CancellationTokenSource? pollCts;
	private Task? pollLoop;

	/// <summary>
	/// The roles every authenticated endpoint accepts — the "Admin,Moderator,User" policy the API
	/// gates them with. An account holding none of them can sign in and then do nothing at all.
	/// </summary>
	private static readonly string[] UsableRoles = ["Admin", "Moderator", "User"];

	/// <summary>
	/// False for the account described under "Enabling an account" in the README: enabled straight
	/// in the database, so it never picked up a role. It looks entirely normal until you notice it
	/// is never online — presence is role-gated like everything else, so its heartbeat is refused.
	/// </summary>
	private static bool HasUsableRole(UserDto user) =>
		user.Roles.Any(role => UsableRoles.Contains(role, StringComparer.OrdinalIgnoreCase));

	protected override async Task OnInitializedAsync()
	{
		// Own id first: the list renders between these two awaits, and with it still null the
		// Delete button would flash onto your own row before being taken away again.
		currentUserId = await AuthStateService.GetUserIdAsync();
		await LoadUsersAsync();

		pollCts = new CancellationTokenSource();
		pollLoop = PollPresenceAsync(pollCts.Token);
	}

	/// <summary>
	/// Keeps the dots and the "laatst actief" lines current while the tab stays open. Only
	/// presence is re-read — the accounts themselves, and their roles, do not change under you.
	/// </summary>
	private async Task PollPresenceAsync(CancellationToken ct)
	{
		using var timer = new PeriodicTimer(PollInterval);

		try
		{
			while (await timer.WaitForNextTickAsync(ct))
				await RefreshPresenceAsync(ct);
		}
		catch (OperationCanceledException)
		{
			// Normal: the tab was left, or the circuit went away.
		}
	}

	private async Task RefreshPresenceAsync(CancellationToken ct)
	{
		// Captured so the reply can be checked against the page it was asked about: a search or a
		// page change mid-flight replaces this object, and the answer is then about a list that
		// is no longer on screen.
		var asked = pagedResult;
		if (asked is null || asked.Items.Count == 0)
			return;

		var result = await AdminService.GetPresenceAsync(asked.Items.Select(u => u.Id));

		// No OrDefault and no OnFailure on purpose: this runs every 30 seconds, and an API that
		// is briefly down would otherwise raise a toast on every tick. A skipped refresh costs
		// nothing — the next one has the same answer.
		if (!result.Success || result.Data is null || ct.IsCancellationRequested || !ReferenceEquals(pagedResult, asked))
			return;

		var byId = asked.Items.ToDictionary(u => u.Id);
		foreach (var presence in result.Data)
		{
			if (!byId.TryGetValue(presence.UserId, out var user))
				continue;

			user.IsOnline = presence.IsOnline;
			user.LastSeenUtc = presence.LastSeenUtc;
		}

		// Unconditional, even when nothing came back changed: "laatst actief 7 min geleden" is
		// measured against the clock, so it goes stale on its own and has to be re-rendered.
		await InvokeAsync(StateHasChanged);
	}

	public async ValueTask DisposeAsync()
	{
		if (pollCts is null)
			return;

		await pollCts.CancelAsync();

		if (pollLoop is not null)
			try { await pollLoop; }
			catch (OperationCanceledException) {}

		pollCts.Dispose();
		pollCts = null;
		pollLoop = null;
	}

	private async Task LoadUsersAsync()
	{
		pagedResult = await AdminService.GetPagedUsersAsync(currentPage, pageSize, searchTerm)
			.OrDefault(new PagedResultDto<UserDto>());
	}

	private async Task OnPageChanged(int page)
	{
		currentPage = page;
		await LoadUsersAsync();
	}

	private async Task OnPageSizeChanged(int size)
	{
		pageSize = size;
		currentPage = 1;
		await LoadUsersAsync();
	}

	private async Task OnSearchChanged(string value)
	{
		searchTerm = value;
		currentPage = 1;
		await LoadUsersAsync();
	}

	public async Task ToggleUserAsync(string email, bool enabled)
	{
		await AdminService.ToggleUserAsync(email, enabled)
			.OnSuccess(() =>
			{
				var user = pagedResult?.Items.FirstOrDefault(u => u.Email == email);
				if (user != null)
					user.Enabled = enabled;
			})
			.OnFailure();
	}

	// Irreversible and one click away from Disable, so it always goes through a prompt that
	// names the account. The API re-checks who the caller is and refuses a self-delete.
	private async Task DeleteUserAsync(string email)
	{
		if (confirmDialog is null)
			return;

		var confirmed = await confirmDialog.ShowAsync(UiText.Users.DeleteTitle, UiText.Users.DeleteMessage(email), UiText.Users.DeleteConfirm, danger: true);

		if (!confirmed)
			return;

		await AdminService.DeleteUserAsync(email)
			.OnSuccess(async () => await LoadUsersAsync(), WebConstants.Messages.Users.Deleted)
			.OnFailure();
	}

}
