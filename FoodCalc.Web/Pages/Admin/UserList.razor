@inject AdminService AdminService
@inject AuthStateService AuthStateService

<div class="fh-stack">
	<div class="user-search">
		<SearchBox Placeholder="@UiText.Users.SearchPlaceholder" Value="@searchTerm" ValueChanged="OnSearchChanged"/>
	</div>

	@if (pagedResult == null)
	{
		<LoadingSpinner Label="@UiText.Users.Loading"/>
	}
	else if (pagedResult.Items.Any())
	{
		<ul class="user-list">
			@foreach (var user in pagedResult.Items)
			{
				<li>
					<a class="user-list__link" href="/admin/userroles/@user.Email">
						<i class="bi bi-person-circle" aria-hidden="true"></i>
						<span class="user-list__email fh-truncate">@user.Email</span>
						@if (user.Enabled)
						{
							<Badge Variant="Badge.BadgeVariant.Success" Icon="check-circle">@UiText.Users.Enabled</Badge>
						}
						else
						{
							<Badge Variant="Badge.BadgeVariant.Danger" Icon="slash-circle">@UiText.Users.Disabled</Badge>
						}
					</a>
					@* Wrapped so the row's space-between keeps the buttons together on the
					   right instead of spreading them across the row. *@
					<div class="user-list__actions">
						@if (user.Id != currentUserId)
						{
							@if (user.Enabled)
							{
								<AppButton Variant="ButtonVariant.OutlineDanger" Size="ButtonSize.Small"
								           OnClick='async () => await ToggleUserAsync(user.Email, false)'>@UiText.Users.Disable
								</AppButton>
							}
							else
							{
								<AppButton Variant="ButtonVariant.OutlineSuccess" Size="ButtonSize.Small"
								           OnClick='async () => await ToggleUserAsync(user.Email, true)'>@UiText.Users.Enable
								</AppButton>
							}

							<AppButton Variant="ButtonVariant.Danger" Size="ButtonSize.Small" Icon="trash"
							           OnClick='async () => await DeleteUserAsync(user.Email)'>@UiText.Users.Delete
							</AppButton>
						}
					</div>
				</li>
			}
		</ul>

		<Paginator TotalCount="pagedResult.TotalCount"
		           Page="pagedResult.Page"
		           PageSize="pagedResult.PageSize"
		           PageChanged="OnPageChanged"
		           PageSizeChanged="OnPageSizeChanged"/>
	}
	else
	{
		<EmptyState Icon="people" Title="@UiText.Users.Empty"/>
	}
</div>

<ConfirmDialog @ref="confirmDialog"/>

@code {
	private PagedResultDto<UserDto>? pagedResult;
	private int currentPage = 1;
	private int pageSize = 50;
	private string searchTerm = string.Empty;
	private ConfirmDialog? confirmDialog;
	private string? currentUserId;

	protected override async Task OnInitializedAsync()
	{
		// Own id first: the list renders between these two awaits, and with it still null the
		// Delete button would flash onto your own row before being taken away again.
		currentUserId = await AuthStateService.GetUserIdAsync();
		await LoadUsersAsync();
	}

	private async Task LoadUsersAsync()
	{
		pagedResult = await AdminService.GetPagedUsersAsync(currentPage, pageSize, searchTerm)
			.OrDefault(new PagedResultDto<UserDto>());
	}

	private async Task OnPageChanged(int page)
	{
		currentPage = page;
		await LoadUsersAsync();
	}

	private async Task OnPageSizeChanged(int size)
	{
		pageSize = size;
		currentPage = 1;
		await LoadUsersAsync();
	}

	private async Task OnSearchChanged(string value)
	{
		searchTerm = value;
		currentPage = 1;
		await LoadUsersAsync();
	}

	public async Task ToggleUserAsync(string email, bool enabled)
	{
		await AdminService.ToggleUserAsync(email, enabled)
			.OnSuccess(() =>
			{
				var user = pagedResult?.Items.FirstOrDefault(u => u.Email == email);
				if (user != null)
					user.Enabled = enabled;
			})
			.OnFailure();
	}

	// Irreversible and one click away from Disable, so it always goes through a prompt that
	// names the account. The API re-checks who the caller is and refuses a self-delete.
	private async Task DeleteUserAsync(string email)
	{
		if (confirmDialog is null)
			return;

		var confirmed = await confirmDialog.ShowAsync(UiText.Users.DeleteTitle, UiText.Users.DeleteMessage(email), UiText.Users.DeleteConfirm, danger: true);

		if (!confirmed)
			return;

		await AdminService.DeleteUserAsync(email)
			.OnSuccess(async () => await LoadUsersAsync(), WebConstants.Messages.Users.Deleted)
			.OnFailure();
	}

}
