@page "/"

@inject RecipeService RecipeService
@inject IngredientService IngredientService
@inject AdminService AdminService
@inject AuthStateService AuthStateService
@inject NavigationManager NavigationManager

<PageTitle>@UiText.Home.Title</PageTitle>

<div class="home-layout">
	@if (!isAdmin)
	{
		<div class="home-header">
			<PageHeader Title="@UiText.Home.WelcomeTitle" Subtitle="@UiText.Home.WelcomeSubtitle"/>
		</div>

		<div class="home-body">
			<section class="fh-stat-grid">
				<div class="fh-stat-card fh-stat-card--primary" @onclick="GoToCalendar" role="button" tabindex="0">
					<div class="fh-stat-icon"><i class="bi bi-calendar-week"></i></div>
					<div class="fh-stat-body">
						<div class="fh-stat-label">@UiText.Home.MealCalendar</div>
						<div class="fh-stat-sub fh-muted">@UiText.Home.MealCalendarHint</div>
					</div>
				</div>

				<div class="fh-stat-card fh-stat-card--accent" @onclick="GoToRecipes" role="button" tabindex="0">
					<div class="fh-stat-icon"><i class="bi bi-journal-text"></i></div>
					<div class="fh-stat-body">
						<div class="fh-stat-label">@UiText.Home.Recipes</div>
						<div class="fh-stat-sub fh-muted">@UiText.Home.RecipesHint</div>
					</div>
				</div>

				<div class="fh-stat-card fh-stat-card--info" @onclick="GoToFindRecipes" role="button" tabindex="0">
					<div class="fh-stat-icon"><i class="bi bi-search-heart"></i></div>
					<div class="fh-stat-body">
						<div class="fh-stat-label">@UiText.Home.FindRecipes</div>
						<div class="fh-stat-sub fh-muted">@UiText.Home.FindRecipesHint</div>
					</div>
				</div>
			</section>
		</div>
	}
	else
	{
		<div class="home-header">
			<PageHeader Title="@UiText.Home.DashboardTitle" Subtitle="@UiText.Home.DashboardSubtitle"/>
		</div>

		<div class="home-body">
			@if (loading)
			{
				<LoadingSpinner Label="@UiText.Home.LoadingDashboard"/>
			}
			else
			{
				<section class="fh-stat-grid">
					<div class="fh-stat-card fh-stat-card--primary" @onclick="GoToRecipes" role="button" tabindex="0">
						<div class="fh-stat-icon"><i class="bi bi-journal-text"></i></div>
						<div class="fh-stat-body">
							<div class="fh-stat-label">@UiText.Home.Recipes</div>
							<div class="fh-stat-value">@recipeCount</div>
						</div>
					</div>

					<div class="fh-stat-card fh-stat-card--accent" @onclick="GoToIngredients" role="button"
					     tabindex="0">
						<div class="fh-stat-icon"><i class="bi bi-egg"></i></div>
						<div class="fh-stat-body">
							<div class="fh-stat-label">@UiText.Home.Ingredients</div>
							<div class="fh-stat-value">@ingredientCount</div>
						</div>
					</div>

					@if (isAdmin)
					{
						<div class="fh-stat-card fh-stat-card--info" @onclick="GoToAdmin" role="button" tabindex="0">
							<div class="fh-stat-icon"><i class="bi bi-people"></i></div>
							<div class="fh-stat-body">
								<div class="fh-stat-label">@UiText.Home.Users</div>
								<div class="fh-stat-value">@userCount</div>
							</div>
						</div>
					}

					<div class="fh-stat-card">
						<div class="fh-stat-icon"><i class="bi bi-bar-chart"></i></div>
						<div class="fh-stat-body">
							<div class="fh-stat-label">@UiText.Home.AvgIngredientsPerRecipe</div>
							<div class="fh-stat-value">@avgIngredientsPerRecipe.ToString("0.0")</div>
						</div>
					</div>

					<div class="fh-stat-card">
						<div class="fh-stat-icon"><i class="bi bi-cart3"></i></div>
						<div class="fh-stat-body">
							<div class="fh-stat-label">@UiText.Home.OnShoppingList</div>
							<div class="fh-stat-value">@shoppingCartIngredientCount</div>
							<div class="fh-stat-sub fh-muted">@UiText.Home.OfIngredients(ingredientCount)</div>
						</div>
					</div>

					<div class="fh-stat-card">
						<div class="fh-stat-icon"><i class="bi bi-link-45deg"></i></div>
						<div class="fh-stat-body">
							<div class="fh-stat-label">@UiText.Home.RecipeIngredientLinks</div>
							<div class="fh-stat-value">@totalRecipeItemLinks</div>
						</div>
					</div>
				</section>

				@if (topIngredients.Any())
				{
					<section class="fh-panel">
						<div class="fh-panel-header">
							<h2 class="fh-subheading">@UiText.Home.TopIngredients</h2>
							<span class="fh-muted">@UiText.Home.TopIngredientsHint</span>
						</div>
						<ol class="fh-top-list">
							@foreach (var item in topIngredients)
							{
								var pct = maxTopUsage == 0 ? 0 : (int) Math.Round(item.UsageCount * 100.0 / maxTopUsage);
								<li>
									<div class="fh-top-row">
										<span class="fh-top-name">@item.Name</span>
										<span class="fh-top-count fh-muted">@UiText.Home.UsedInRecipes(item.UsageCount)</span>
									</div>
									<div class="fh-top-bar"><span style="width:@(pct)%;"></span></div>
								</li>
							}
						</ol>
					</section>
				}
			}
		</div>
	}
</div>

@code {
	private bool loading = true;
	private bool isAdmin;

	private int recipeCount;
	private int ingredientCount;
	private int userCount;
	private int shoppingCartIngredientCount;
	private int totalRecipeItemLinks;
	private double avgIngredientsPerRecipe;

	private List<IngredientUsage> topIngredients = new();
	private int maxTopUsage;

	protected override async Task OnInitializedAsync()
	{
		try { isAdmin = await AuthStateService.IsAdminAsync(); }
		catch { isAdmin = false; }

		// Regular users get a lightweight landing page — no dashboard stats to load.
		if (!isAdmin)
		{
			loading = false;
			return;
		}

		var recipes = await RecipeService.GetAllRecipesAsync(withIngredients: true)
			.OrDefault(new List<RecipeDto>());
		var ingredientsPage = await IngredientService.GetPagedIngredientsAsync(1, 1)
			.OrDefault(new PagedResultDto<IngredientDto>());

		recipeCount = recipes.Count;
		ingredientCount = ingredientsPage.TotalCount;

		if (isAdmin)
		{
			var usersResult = await AdminService.GetPagedUsersAsync(1, 1)
				.OrDefault(new PagedResultDto<UserDto>());
			userCount = usersResult.TotalCount;
		}

		ComputeRecipeStats(recipes);

		loading = false;
	}

	private void ComputeRecipeStats(List<RecipeDto> recipes)
	{
		totalRecipeItemLinks = recipes.Sum(r => r.Ingredients.Count);
		avgIngredientsPerRecipe = recipes.Count == 0 ? 0 : (double) totalRecipeItemLinks / recipes.Count;

		var seenShoppingIngredients = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
		var usage = new Dictionary<string, IngredientUsage>(StringComparer.OrdinalIgnoreCase);

		foreach (var recipe in recipes)
		{
			if (recipe.Ingredients.Any()) continue;
			var recipeItemNames = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
			foreach (var ri in recipe.Ingredients)
			{
				if (ri.ShouldBeAddedToShoppingCart)
					seenShoppingIngredients.Add(ri.Ingredient.Name);

				if (recipeItemNames.Add(ri.Ingredient.Name))
				{
					if (!usage.TryGetValue(ri.Ingredient.Name, out var u))
					{
						u = new IngredientUsage
						{
							Name = ri.Ingredient.Name
						};
						usage[ri.Ingredient.Name] = u;
					}
					
					u.UsageCount++;
				}
			}
		}

		shoppingCartIngredientCount = seenShoppingIngredients.Count;

		topIngredients = usage.Values.OrderByDescending(u => u.UsageCount)
			.ThenBy(u => u.Name)
			.Take(10)
			.ToList();

		maxTopUsage = topIngredients.Count == 0 ? 0 : topIngredients.Max(t => t.UsageCount);
	}

	private void GoToRecipes() => NavigationManager.NavigateTo("/recipes");
	// The catalog is a tab on the admin page now; ?tab= is what makes it the opening one.
	private void GoToIngredients() => NavigationManager.NavigateTo("/admin?tab=ingredients");
	private void GoToAdmin() => NavigationManager.NavigateTo("/admin");
	private void GoToCalendar() => NavigationManager.NavigateTo("/calendar");
	private void GoToFindRecipes() => NavigationManager.NavigateTo("/recipes/find");

	private class IngredientUsage
	{
		public string Name { get; set; } = string.Empty;
		public int UsageCount { get; set; }
	}

}
