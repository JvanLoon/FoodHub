@page "/admin"
@using Microsoft.AspNetCore.WebUtilities
@inject AuthStateService AuthStateService
@inject NavigationManager Navigation

<PageTitle>@UiText.Admin.PageTitle</PageTitle>

@* Moderators reach this page for the review queue and nothing else, so the tab set is built
   from the caller's role rather than rendered whole and partly hidden — a Tab registers itself
   with the TabSet on init, so a tab that must not exist has to not be rendered at all.
   The API enforces the same split independently; this only decides what is worth showing. *@
@if (_authorized)
{
	<div class="fh-stack">
		<PageHeader Title="@(_isAdmin ? UiText.Admin.AdminHeading : UiText.Admin.ModerationHeading)"/>

		<TabSet InitialTab="@_initialTab">
			<Tab Id="review" Title="@UiText.Admin.TabReview" Icon="check2-square">
				<ReviewQueue/>
			</Tab>
			@* Moderators manage the ingredient catalog too — it used to be its own
			   /ingredients route with the same Admin-or-Moderator gate. *@
			<Tab Id="ingredients" Title="@UiText.Admin.TabIngredients" Icon="egg">
				<IngredientList/>
			</Tab>
			@if (_isAdmin)
			{
				<Tab Id="users" Title="@UiText.Admin.TabUsers" Icon="people">
					<UserList/>
				</Tab>
				<Tab Id="importexport" Title="@UiText.Admin.TabImportExport" Icon="arrow-down-up">
					<DataImportExport/>
				</Tab>
				<Tab Id="errortest" Title="@UiText.Admin.TabErrorTest" Icon="bug">
					<ErrorTest/>
				</Tab>
			}
		</TabSet>
	</div>
}

@code {
	private bool _authorized;
	private bool _isAdmin;
	private string? _initialTab;

	protected override async Task OnInitializedAsync()
	{
		// ?tab=<Tab.Id> lets a link elsewhere (the dashboard's ingredient card) land on the
		// right tab. An unknown or missing value just leaves the first tab selected.
		_initialTab = QueryHelpers.ParseQuery(new Uri(Navigation.Uri).Query)
			.TryGetValue("tab", out var tab)
			? tab.ToString()
			: null;

		try
		{
			_isAdmin = await AuthStateService.IsAdminAsync();
			_authorized = _isAdmin || await AuthStateService.IsInAnyRoleAsync("Moderator");
		}
		catch
		{
			_isAdmin = false;
			_authorized = false;
		}

		// Nothing renders until authorization is settled, so a user who types /admin never
		// sees the panel flash before the redirect (same approach as RoleGuard).
		if (!_authorized)
			Navigation.NavigateTo("/");
	}

}
