@using FoodCalc.Web.Services
@using FoodCalc.Web.Services.Admin
@inject AdminService AdminService
@inject MessageService MessageService

<div class="fh-stack">
	<AppCard>
		<p class="text-body-secondary">
			@UiText.ErrorTest.Intro
		</p>
		<ul class="text-body-secondary">
			<li>
				<strong>@UiText.ErrorTest.BulletPositiveCount</strong>@UiText.ErrorTest.BulletPositiveCountText
			</li>
			<li>
				<strong>@UiText.ErrorTest.BulletZeroCount</strong>@UiText.ErrorTest.BulletZeroCountText<code>WebConstants.Messages.Client</code>.
			</li>
			<li>
				<strong>@UiText.ErrorTest.BulletSuccessStatus</strong>@UiText.ErrorTest.BulletSuccessStatusText
			</li>
		</ul>

		<EditForm Model="form" OnValidSubmit="TriggerAsync" FormName="error-test-form">
			<div class="error-test__controls">
				<NumberField TValue="int" Label="@UiText.ErrorTest.CountLabel" @bind-Value="form.Count"/>

				<SelectField TValue="int" Label="@UiText.ErrorTest.StatusCodeLabel" @bind-Value="form.StatusCode">
					<optgroup label="@UiText.ErrorTest.GroupSuccess">
						<option value="200">@UiText.ErrorTest.Status200</option>
						<option value="201">@UiText.ErrorTest.Status201</option>
						<option value="202">@UiText.ErrorTest.Status202</option>
						<option value="204">@UiText.ErrorTest.Status204</option>
					</optgroup>
					<optgroup label="@UiText.ErrorTest.GroupClient">
						<option value="400">@UiText.ErrorTest.Status400</option>
						<option value="401">@UiText.ErrorTest.Status401</option>
						<option value="403">@UiText.ErrorTest.Status403</option>
						<option value="404">@UiText.ErrorTest.Status404</option>
						<option value="405">@UiText.ErrorTest.Status405</option>
						<option value="408">@UiText.ErrorTest.Status408</option>
						<option value="409">@UiText.ErrorTest.Status409</option>
						<option value="413">@UiText.ErrorTest.Status413</option>
						<option value="415">@UiText.ErrorTest.Status415</option>
						<option value="422">@UiText.ErrorTest.Status422</option>
						<option value="429">@UiText.ErrorTest.Status429</option>
						<option value="418">@UiText.ErrorTest.Status418</option>
					</optgroup>
					<optgroup label="@UiText.ErrorTest.GroupServer">
						<option value="500">@UiText.ErrorTest.Status500</option>
						<option value="501">@UiText.ErrorTest.Status501</option>
						<option value="502">@UiText.ErrorTest.Status502</option>
						<option value="503">@UiText.ErrorTest.Status503</option>
						<option value="504">@UiText.ErrorTest.Status504</option>
						<option value="511">@UiText.ErrorTest.Status511</option>
					</optgroup>
				</SelectField>
			</div>

			<AppButton Type="submit" Icon="exclamation-triangle" Loading="running">
				@UiText.ErrorTest.TriggerButton
			</AppButton>
		</EditForm>
	</AppCard>

	@if (result is not null)
	{
		<AppCard>
			<h3 class="h5">@UiText.ErrorTest.LastResult</h3>

			<p>
				<Badge Variant="@(result.Success ? Badge.BadgeVariant.Success : Badge.BadgeVariant.Danger)">
					@(result.Success ? UiText.ErrorTest.Succeeded : UiText.ErrorTest.Failed)
				</Badge>
				<span class="text-body-secondary">HTTP @result.StatusCode</span>
			</p>

			@if (result.Errors.Count == 0)
			{
				<EmptyState Icon="check-circle" Title="@UiText.ErrorTest.NoErrorsReturned"/>
			}
			else
			{
				<p class="text-body-secondary">@UiText.ErrorTest.ErrorsParsed(result.Errors.Count)</p>
				<ol class="error-test__list">
					@foreach (var error in result.Errors)
					{
						<li>@error</li>
					}
				</ol>
			}
		</AppCard>
	}
</div>

@code {

	private sealed class ErrorTestForm
	{
		public int Count { get; set; } = 3;
		public int StatusCode { get; set; } = 400;
	}

	private readonly ErrorTestForm form = new();
	private ApiResult? result;
	private bool running;

	private async Task TriggerAsync()
	{
		running = true;

		// OnFailure() raises the toasts; the returned result is what the panel below renders,
		// so the two views of the same failure can be compared.
		result = await AdminService.TriggerErrorTestAsync(form.Count, form.StatusCode)
			.OnSuccess(ShowSuccess)
			.OnFailure();

		running = false;
	}

	// 204 No Content comes back with an empty body (a body is forbidden on 204), so there is
	// nothing to toast — stay silent rather than showing a blank message.
	private void ShowSuccess(string message)
	{
		if (!string.IsNullOrWhiteSpace(message))
			MessageService.ShowMessage(message, false);
	}

}
