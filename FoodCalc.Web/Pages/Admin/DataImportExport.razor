@using FoodCalc.Web.Constants
@using FoodCalc.Web.Services.Admin
@inject ImportExportService importExportService
@inject MessageService messageService
@inject IOptions<ImportExportSettings> ImportExportOptions

<PageTitle>@UiText.ImportExport.PageTitle</PageTitle>

<div class="fh-stack">
	<PageHeader Title="@UiText.ImportExport.PageTitle"/>

	<div class="row g-4">
		<div class="col-md-6">
			<AppCard>
				<Header>@UiText.ImportExport.ExportHeader</Header>
				<Body>
				<p class="fh-muted">@UiText.ImportExport.ExportDescription</p>
				<AppButton Icon="download" OnClick="ExportData">@UiText.ImportExport.ExportButton</AppButton>
				</Body>
			</AppCard>
		</div>

		<div class="col-md-6">
			<AppCard>
				<Header>@UiText.ImportExport.ImportHeader</Header>
				<Body>
				<div class="fh-field">
					<label class="form-label" for="importFile">@UiText.ImportExport.ImportFileLabel</label>
					<InputFile id="importFile" class="form-control" OnChange="HandleFileSelected" accept=".json"/>
				</div>
				<div class="fh-cluster">
					<AppButton Icon="upload" OnClick="ImportData">@UiText.ImportExport.ImportButton</AppButton>
				</div>
				<p class="fh-muted">@UiText.ImportExport.OldFormatHint</p>
				</Body>
			</AppCard>
		</div>
	</div>
</div>

@code {
	private const string ExportFormat = "json";
	private IBrowserFile? _selectedFile;

	private void HandleFileSelected(InputFileChangeEventArgs e)
	{
		_selectedFile = e.File;
	}

	private async Task ExportData()
	{
		try
		{
			messageService.ShowMessage(WebConstants.Messages.ImportExport.PreparingExport, false, 0);
			await importExportService.ExportAsync(ExportFormat);
		}
		catch (Exception ex) { messageService.ShowMessage(WebConstants.Messages.ImportExport.ExportFailed(ex.Message), true); }
	}

	private Task ImportData() => RunImportAsync((bytes, name) => importExportService.ImportAsync(bytes, name));

	private async Task RunImportAsync(Func<byte[], string, Task<ApiResult>> import)
	{
		try
		{
			if (_selectedFile == null)
			{
				messageService.ShowMessage(WebConstants.Messages.ImportExport.SelectFileFirst, true);
				return;
			}

			if (!_selectedFile.Name.EndsWith(".json", StringComparison.OrdinalIgnoreCase))
			{
				messageService.ShowMessage(WebConstants.Messages.ImportExport.OnlyJsonAccepted, true);
				return;
			}

			using var stream = _selectedFile.OpenReadStream(maxAllowedSize: ImportExportSettings.DefaultMaxFileSizeInBytes);
			using var ms = new MemoryStream();
			await stream.CopyToAsync(ms);
			var bytes = ms.ToArray();

			if (bytes.Length == 0)
			{
				messageService.ShowMessage(WebConstants.Messages.ImportExport.CouldNotReadFile, true);
				return;
			}

			var result = await import(bytes, _selectedFile.Name)
				.OnSuccess(message: WebConstants.Messages.ImportExport.ImportSucceeded)
				.OnFailure();
		}
		catch (Exception ex) { messageService.ShowMessage(WebConstants.Messages.ImportExport.ImportFailed(ex.Message), true); }
	}

}
