@page "/Error"
@using System.Diagnostics

<PageTitle>@UiText.ErrorPage.Title</PageTitle>

<div class="error-page">
	<i class="bi bi-emoji-dizzy" aria-hidden="true"></i>
	<h1>@UiText.ErrorPage.Heading</h1>
	<p>@UiText.ErrorPage.Message</p>

	@if (ShowRequestId)
	{
		<p class="error-page__request">
			<strong>@UiText.ErrorPage.RequestIdLabel</strong> <code>@requestId</code>
		</p>
	}

	<p class="error-page__hint">
		@UiText.ErrorPage.DevHintBefore<strong>@UiText.ErrorPage.DevHintEnvironment</strong>@UiText.ErrorPage.DevHintAfter
	</p>
</div>

@code {

	[CascadingParameter]
	public HttpContext? HttpContext { get; set; }

	private string? requestId;
	private bool ShowRequestId => !string.IsNullOrEmpty(requestId);

	protected override void OnInitialized()
	{
		requestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
	}

}
