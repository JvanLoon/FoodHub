@page "/usersettings"
@using FoodCalc.Web.Services.Auth
@inject AuthStateService AuthStateService

<PageTitle>@UiText.UserSettings.Title</PageTitle>

<div class="fh-stack">
	<PageHeader Title="@UiText.UserSettings.Title"/>

	@if (string.IsNullOrEmpty(email))
	{
		<LoadingSpinner Label="@UiText.UserSettings.Loading"/>
	}
	else
	{
		<div class="settings-card">
			<AppCard>
				<Header>@UiText.UserSettings.AccountHeader</Header>
				<Body>
				<div class="settings-row">
					<i class="bi bi-envelope" aria-hidden="true"></i>
					<span class="fh-muted">@UiText.UserSettings.EmailLabel</span>
					<span class="settings-row__value fh-truncate" title="@email">@email</span>
				</div>
				</Body>
			</AppCard>
		</div>
	}
</div>

@code {
	private string? email;

	protected override async Task OnInitializedAsync()
	{
		email = await AuthStateService.GetEmailAsync();
	}

}
