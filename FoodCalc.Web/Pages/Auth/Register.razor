@page "/register"
@layout Layout.LoginLayout
@inject LoginService LoginService

@inject NavigationManager Navigation

<PageTitle>@UiText.Auth.RegisterTitle</PageTitle>

<div class="auth-card">
	<div class="auth-card__brand">
		<i class="bi bi-basket2-fill" aria-hidden="true"></i>
		<span>FoodHub</span>
	</div>
	<h3 class="auth-card__title">@UiText.Auth.RegisterHeading</h3>
	<EditForm Model="registerModel" OnValidSubmit="HandleRegister" FormName="register-form">
		<DataAnnotationsValidator/>
		<ValidationSummary class="mb-3"/>
		<TextField Label="@UiText.Auth.EmailLabel" Placeholder="@UiText.Auth.EmailPlaceholder" Autocomplete="username"
		           @bind-Value="registerModel.Email"/>
		<TextField Label="@UiText.Auth.PasswordLabel" Type="password" Placeholder="@UiText.Auth.PasswordPlaceholder"
		           Autocomplete="new-password"
		           @bind-Value="registerModel.Password"/>
		<AppButton Type="submit" Variant="ButtonVariant.Success" Icon="person-plus" CssClass="w-100">@UiText.Auth.RegisterButton
		</AppButton>
	</EditForm>
	<div class="auth-card__alt">
		<a href="/login">@UiText.Auth.HaveAccountLink</a>
	</div>
</div>

@code {
	private RegisterDto registerModel { get; set; } = new();

	private async Task HandleRegister()
	{
		await LoginService.RegisterAsync(registerModel)
			.OnSuccess(() => Navigation.NavigateTo("/login"), WebConstants.Messages.Auth.RegisterSuccess)
			.OnFailure();
	}

}
