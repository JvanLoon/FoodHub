# LOCAL ONLY — gitignored. Do not commit.
# Replaces the deleted appsettings.json / appsettings.Development.json.

Logging__LogLevel__Default=Information
Logging__LogLevel__Microsoft.AspNetCore=Warning

DetailedErrors=true

# FoodCalc.Api's https launchSettings port. Under the Aspire AppHost the API is
# proxied on that same port, so this one value covers both local run modes.
API__BaseAddress=https://localhost:7426

# TODO rotate before deploying — this key is in the public git history.
# Must stay byte-for-byte identical to FoodCalc.Api/.env, or every login fails.
Jwt__Key=673JPGwfb$r!8SB3pVgXJR&&kaRSKqp5pGdtbg$H
Jwt__Issuer=FoodCalc
Jwt__Audience=FoodHub-Api-user
