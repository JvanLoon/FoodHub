{
  "$schema": "https://json.schemastore.org/launchsettings.json",
  "profiles": {
    // Plain HTTP against a locally running API (docker compose up -d db api), for UI work
    // without the Aspire host. API:BaseAddress and Jwt:* come from user secrets, which only
    // load in Development — hence this profile rather than --no-launch-profile.
    "http": {
      "commandName": "Project",
      "dotnetRunMessages": true,
      "launchBrowser": false,
      "applicationUrl": "http://localhost:5252",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      }
    },
    "https": {
      "commandName": "Project",
      "dotnetRunMessages": true,
      "launchBrowser": true,
      "applicationUrl": "https://localhost:7049",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      }
    }
  }
}
