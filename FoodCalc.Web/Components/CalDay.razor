@* One day cell on the meal calendar. Clicking the body toggles selection;
   the + and × buttons stop propagation so they don't toggle.

   ReadOnly strips every affordance except selection, for the add-to-calendar picker:
   there the day's meals are context, not things to open or delete, and opening a recipe
   would navigate the page out from under the modal.
   Disabled marks a day that cannot be picked — in the picker, one that already holds the
   recipe being added. *@

<div class="@CssClass" @onclick="HandleSelect">
	<div class="cal-day__head">
		<span class="cal-day__num">@(Compact ? Day.Day.ToString() : UiText.Calendar.DayLabel(Day))</span>
		@if (Disabled)
		{
			<i class="bi bi-check-circle-fill cal-day__planned" title="@UiText.Calendar.AlreadyPlanned"></i>
		}
		else if (!ReadOnly)
		{
			<button type="button" class="cal-day__add" title="@UiText.Calendar.AddRecipe"
			        @onclick="OnAdd" @onclick:stopPropagation="true">
				<i class="bi bi-plus-lg"></i>
			</button>
		}
	</div>
	<ul class="cal-day__list">
		@foreach (var entry in Entries)
		{
			<li class="cal-meal" title="@entry.RecipeName">
				@if (ReadOnly)
				{
					<span class="cal-meal__name cal-meal__name--static">@entry.RecipeName</span>
				}
				else
				{
					<button type="button" class="cal-meal__name" title="@UiText.Calendar.OpenRecipe"
					        @onclick="() => OnOpen.InvokeAsync(entry)" @onclick:stopPropagation="true">
						@entry.RecipeName
					</button>
					<button type="button" class="cal-meal__x" title="@UiText.Calendar.RemoveRecipe"
					        @onclick="() => OnRemove.InvokeAsync(entry)" @onclick:stopPropagation="true">
						<i class="bi bi-x"></i>
					</button>
				}
			</li>
		}
	</ul>
</div>

@code {

	[Parameter, EditorRequired]
	public DateOnly Day { get; set; }

	[Parameter]
	public bool Compact { get; set; }

	[Parameter]
	public bool Selected { get; set; }

	[Parameter]
	public bool IsOtherMonth { get; set; }

	/// <summary>Show the day and its meals, but offer nothing to click except selection.</summary>
	[Parameter]
	public bool ReadOnly { get; set; }

	/// <summary>Cannot be selected. Rendered muted with a marker instead of the add button.</summary>
	[Parameter]
	public bool Disabled { get; set; }

	[Parameter]
	public List<MealPlanEntryDto> Entries { get; set; } = new();

	[Parameter]
	public EventCallback OnSelect { get; set; }

	[Parameter]
	public EventCallback OnAdd { get; set; }

	[Parameter]
	public EventCallback<MealPlanEntryDto> OnRemove { get; set; }

	[Parameter]
	public EventCallback<MealPlanEntryDto> OnOpen { get; set; }

	private Task HandleSelect() => Disabled ? Task.CompletedTask : OnSelect.InvokeAsync();

	private string CssClass
	{
		get
		{
			var cls = "cal-day";
			if (Compact) cls += " cal-day--compact";
			if (Selected) cls += " cal-day--selected";
			if (Day == DateOnly.FromDateTime(DateTime.Today)) cls += " cal-day--today";
			if (IsOtherMonth) cls += " cal-day--muted";
			if (Disabled) cls += " cal-day--disabled";
			return cls;
		}
	}

}
