@* Selectable recipe card for the Home grid. Selection toggles on mousedown
   (matches previous behavior); footer actions stop propagation so Edit and
   Delete don't toggle the card. *@

<div class="card fh-recipe-card @(Selected ? "fh-recipe-card--selected" : null)"
     draggable="false"
     @onmousedown="OnToggle">
	<div class="fh-recipe-card__media">
		@if (!string.IsNullOrEmpty(ImageUrl))
		{
			<img src="@ImageUrl" alt="" draggable="false"/>
		}
		else { <i class="bi bi-egg-fried" aria-hidden="true"></i> }
		<span class="fh-recipe-card__check" aria-hidden="@(!Selected)">
            <i class="bi bi-check-circle-fill"></i>
        </span>
	</div>
	<div class="card-body">
		@if (OnOpen.HasDelegate)
		{
			<button type="button" class="fh-card-title card-title--link" title="@Title"
			        @onmousedown:stopPropagation @onclick="OnOpen">@Title</button>
		}
		else
		{
			<h5 class="fh-card-title" title="@Title">@Title</h5>
		}
		@ChildContent
	</div>
	@* The footer used to render only for owners, because edit and delete were all it held.
	   Add-to-calendar is for everyone, so the footer now appears whenever either is
	   available and each half is gated separately. *@
	@if (ShowActions || OnAddToCalendar.HasDelegate)
	{
		<div class="card-footer" @onmousedown:stopPropagation>
			@if (OnAddToCalendar.HasDelegate)
			{
				@* Wrapped so the scoped margin rule has an element it can reach: IconButton
				   is a child component, and its root never carries this file's scope. *@
				<span class="fh-recipe-card__lead">
					<IconButton Icon="calendar-plus" Title="@UiText.Calendar.AddToCalendar"
					            Variant="ButtonVariant.Primary" StopPropagation
					            OnClick="OnAddToCalendar"/>
				</span>
			}
			@if (ShowActions)
			{
				<AppButton Variant="ButtonVariant.OutlineSecondary" Size="ButtonSize.Small" Icon="pencil"
				           StopPropagation OnClick="OnEdit">@UiText.Common.Edit
				</AppButton>
				<AppButton Variant="ButtonVariant.OutlineDanger" Size="ButtonSize.Small" Icon="trash"
				           StopPropagation OnClick="OnDelete">@UiText.Common.Delete
				</AppButton>
			}
		</div>
	}
</div>

@code {

	[Parameter, EditorRequired]
	public string Title { get; set; } = string.Empty;

	[Parameter]
	public string? ImageUrl { get; set; }

	[Parameter]
	public bool Selected { get; set; }

	[Parameter]
	public bool ShowActions { get; set; } = true;

	[Parameter]
	public EventCallback OnToggle { get; set; }

	[Parameter]
	public EventCallback OnOpen { get; set; }

	[Parameter]
	public EventCallback OnEdit { get; set; }

	[Parameter]
	public EventCallback OnDelete { get; set; }

	/// <summary>
	/// Plan this recipe on the calendar. Available to every signed-in user, unlike
	/// <see cref="OnEdit"/> and <see cref="OnDelete"/>; leave unset to omit the button.
	/// </summary>
	[Parameter]
	public EventCallback OnAddToCalendar { get; set; }

	[Parameter]
	public RenderFragment? ChildContent { get; set; }

}
