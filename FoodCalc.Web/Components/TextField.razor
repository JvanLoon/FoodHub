@* Label + InputText + validation message. Use inside an EditForm with
   @bind-Value, exactly like InputText. *@
@using System.Linq.Expressions

<div class="fh-field @CssClass">
	@if (!string.IsNullOrEmpty(Label))
	{
		<label class="form-label" for="@Id">@Label</label>
	}
	<div class="fh-field__control @(ShowRevealToggle ? "fh-field__control--with-toggle" : null)">
		<InputText id="@Id"
		           class="form-control"
		           type="@Type"
		           placeholder="@Placeholder"
		           autocomplete="@Autocomplete"
		           Value="@Value"
		           ValueChanged="ValueChanged"
		           ValueExpression="ValueExpression"/>
		@* Plain JS rather than an @onclick: the only field that asks for this is the password on
		   the login page, which renders statically (see App.razor) and has no circuit to
		   dispatch an event to. The labels ride along as data attributes because the swap
		   happens in the browser, where the Dutch strings are not otherwise available. *@
		@if (ShowRevealToggle)
		{
			<button type="button"
			        class="fh-field__reveal"
			        title="@UiText.Components.ShowPassword"
			        aria-label="@UiText.Components.ShowPassword"
			        aria-controls="@Id"
			        aria-pressed="false"
			        data-reveal-for="@Id"
			        data-label-show="@UiText.Components.ShowPassword"
			        data-label-hide="@UiText.Components.HidePassword"
			        onclick="fieldInterop.toggleReveal(this)">
				<i class="bi bi-eye" aria-hidden="true"></i>
			</button>
		}
	</div>
	@if (ValueExpression is not null)
	{
		<ValidationMessage For="ValueExpression"/>
	}
</div>

@code {

	[Parameter]
	public string? Label { get; set; }

	[Parameter]
	public string Id { get; set; } = $"fh-field-{Guid.NewGuid():N}";

	[Parameter]
	public string Type { get; set; } = "text";

	/// <summary>Shows an eye button that toggles the value between hidden and plain text. Only meaningful for Type="password".</summary>
	[Parameter]
	public bool ShowRevealToggle { get; set; }

	[Parameter]
	public string? Placeholder { get; set; }

	[Parameter]
	public string? Autocomplete { get; set; }

	[Parameter]
	public string? CssClass { get; set; }

	[Parameter]
	public string? Value { get; set; }

	[Parameter]
	public EventCallback<string?> ValueChanged { get; set; }

	[Parameter]
	public Expression<Func<string?>>? ValueExpression { get; set; }

}
