@* State-driven tabs (no Bootstrap JS). Usage:
   <TabSet><Tab Title="Users">...</Tab><Tab Title="Roles">...</Tab></TabSet> *@

<CascadingValue Value="this" IsFixed="true">
	<div class="fh-tabset">
		<div class="fh-tabset__bar" role="tablist">
			@foreach (var tab in _tabs)
			{
				<button type="button"
				        role="tab"
				        class="fh-tabset__tab @(tab == ActiveTab ? "fh-tabset__tab--active" : null)"
				        aria-selected="@(tab == ActiveTab)"
				        @onclick="() => Activate(tab)">
					@if (!string.IsNullOrEmpty(tab.Icon))
					{
						<i class="bi bi-@tab.Icon" aria-hidden="true"></i>
					}
					@tab.Title
				</button>
			}
		</div>
		<div class="fh-tabset__panel" role="tabpanel">
			@ChildContent
		</div>
	</div>
</CascadingValue>

@code {

	[Parameter]
	public RenderFragment? ChildContent { get; set; }

	/// <summary>
	/// <see cref="Tab.Id"/> to open on first render instead of the first tab. Ignored once
	/// the user has picked a tab, and ignored if no tab carries that id.
	/// </summary>
	[Parameter]
	public string? InitialTab { get; set; }

	private readonly List<Tab> _tabs = new();
	private bool _userPicked;

	internal Tab? ActiveTab { get; private set; }

	internal void AddTab(Tab tab)
	{
		_tabs.Add(tab);

		// Tabs register themselves as they render, so the requested one may arrive after a
		// default has already been chosen — it still wins, until the user picks for himself.
		if (ActiveTab is null || (!_userPicked && IsRequested(tab)))
			ActiveTab = tab;

		StateHasChanged();
	}

	private bool IsRequested(Tab tab) =>
		!string.IsNullOrEmpty(InitialTab) &&
		string.Equals(tab.Id, InitialTab, StringComparison.OrdinalIgnoreCase);

	private void Activate(Tab tab)
	{
		ActiveTab = tab;
		_userPicked = true;
	}

}
