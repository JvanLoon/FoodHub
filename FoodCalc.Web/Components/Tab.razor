@if (TabSet?.ActiveTab == this) { @ChildContent }

@code {

	[CascadingParameter]
	private TabSet? TabSet { get; set; }

	[Parameter, EditorRequired]
	public string Title { get; set; } = string.Empty;

	/// <summary>
	/// Stable, non-localised handle used by <see cref="TabSet.InitialTab"/> so a link can
	/// open this tab without depending on its display title.
	/// </summary>
	[Parameter]
	public string? Id { get; set; }

	[Parameter]
	public string? Icon { get; set; }

	[Parameter]
	public RenderFragment? ChildContent { get; set; }

	protected override void OnInitialized()
	{
		if (TabSet is null)
			throw new InvalidOperationException($"{nameof(Tab)} must be placed inside a {nameof(TabSet)}.");

		TabSet.AddTab(this);
	}

}
