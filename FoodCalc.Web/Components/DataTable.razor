@* Minimal styled table: pass HeaderContent (th cells) and RowTemplate (td
   cells per item). Null Items shows a loading row; an empty list shows
   EmptyText.

   Set StackOnMobile when the columns are worth reading on a phone: each row then
   becomes a card and each cell picks up its own label. That only works if the cells
   carry data-label, so it is opt-in rather than the default — tables without it keep
   scrolling sideways, which is still the right answer for wide, scan-only data. *@
@typeparam TItem

<div class="fh-table-wrap @(StackOnMobile ? "fh-table-wrap--stack" : null) @CssClass">
	<table class="table table-hover fh-table align-middle">
		<thead>
		<tr>@HeaderContent</tr>
		</thead>
		<tbody>
		@if (Items is null)
		{
			<tr>
				<td colspan="100">
					<LoadingSpinner Label="@LoadingText"/>
				</td>
			</tr>
		}
		else if (!Items.Any())
		{
			<tr>
				<td colspan="100">
					<EmptyState Icon="inbox" Title="@EmptyText"/>
				</td>
			</tr>
		}
		else
		{
			@foreach (var item in Items)
			{
				<tr>@RowTemplate?.Invoke(item)</tr>
			}
		}
		</tbody>
	</table>
</div>

@code {

	[Parameter]
	public IEnumerable<TItem>? Items { get; set; }

	[Parameter]
	public RenderFragment? HeaderContent { get; set; }

	[Parameter]
	public RenderFragment<TItem>? RowTemplate { get; set; }

	[Parameter]
	public string EmptyText { get; set; } = UiText.Common.Nothing;

	[Parameter]
	public string LoadingText { get; set; } = UiText.Common.Loading;

	[Parameter]
	public string? CssClass { get; set; }

	/// <summary>
	/// Render each row as a labelled card below the compact breakpoint instead of scrolling
	/// the table sideways. Requires every <c>td</c> in <see cref="RowTemplate"/> to carry a
	/// <c>data-label</c> attribute — that is where the per-cell labels come from.
	/// </summary>
	[Parameter]
	public bool StackOnMobile { get; set; }

}
