# Local development configuration for FoodCalc.Web.
# Copy to `.env` (gitignored) and fill in. Loaded by DotNetEnv at startup.
#
#   cp .env.example .env
#
# NAMING RULES — a DOUBLE underscore is the ':' config separator, and nothing
# else. A single underscore inside a segment is a literal character, so
# API_BASE_ADDRESS would become the key "API_BASE_ADDRESS" and match nothing.
# Segment names must equal the C# key (case-insensitively) with no underscores
# added:
#
#   Configuration["API:BaseAddress"]  ->  API__BaseAddress
#
# Real environment variables win over this file (NoClobber), so the values
# docker compose sets are authoritative in a container.

Logging__LogLevel__Default=Information
Logging__LogLevel__Microsoft.AspNetCore=Warning

DetailedErrors=true

# Where this app calls the API. Startup throws if it is missing.
# Matches FoodCalc.Api's https launchSettings port — under the Aspire AppHost the
# API is proxied on that same port, so one value covers both local run modes.
API__BaseAddress=https://localhost:7426

# Must be byte-for-byte identical to FoodCalc.Api's Jwt__Key: the API signs the
# tokens and this app validates them against the same secret. At least 32 bytes.
#   openssl rand -base64 48
Jwt__Key=
Jwt__Issuer=FoodCalc
Jwt__Audience=FoodHub-Api-user
