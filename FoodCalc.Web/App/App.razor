@using Microsoft.AspNetCore.Components.Endpoints

<!DOCTYPE html>
<html lang="nl">

<head>
	<meta charset="utf-8"/>
	<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
	<base href="/"/>
	<script>
		// Apply the persisted theme before first paint to avoid a flash of the wrong theme.
		(function() {
			var theme = localStorage.getItem('foodhub-theme');
			if (theme !== 'light' && theme !== 'dark') {
				theme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
			}
			document.documentElement.setAttribute('data-bs-theme', theme);
		})();
	</script>
	@* @Assets[..] stamps a content hash into each URL, so a deploy changes the URL and no
	   cache — browser or Cloudflare — can keep serving the previous build's file. Bare hrefs
	   here meant an unchanged URL for changed content, which is how prod ended up on a
	   four-hour-old stylesheet. Requires app.MapStaticAssets() in Program.cs. *@
	<link rel="stylesheet" href="@Assets["lib/bootstrap/dist/css/bootstrap.min.css"]"/>
	<link rel="stylesheet" href="@Assets["lib/bootstrap-icons/bootstrap-icons.min.css"]"/>
	<link rel="stylesheet" href="@Assets["css/tokens.css"]"/>
	<link rel="stylesheet" href="@Assets["css/theme.css"]"/>
	<link rel="stylesheet" href="@Assets["css/utilities.css"]"/>
	<link rel="stylesheet" href="@Assets["app.css"]"/>
	<link rel="stylesheet" href="@Assets["FoodCalc.Web.styles.css"]"/>
	@* Left unfingerprinted: browsers also probe /favicon.ico on their own, so the hashed
	   URL buys nothing here. *@
	<link rel="icon" type="image/png" href="favicon.png"/>
	@if (RetryForCookie)
	{
		@* Arrived from another site, so the Strict auth cookie was withheld — but the Lax hint
		   came through, so there is a session to recover. Reloading from inside the loaded
		   document is a same-site navigation, which does carry the cookie, and location.replace
		   keeps the URL and leaves no extra history entry to go Back into.

		   In <head> and before anything else so it fires before the page is drawn: the visitor
		   should never see a flash of the signed-out layout. The meta refresh is the same thing
		   for a browser with script off. AuthCookie.UseSessionHint has already dropped the hint,
		   so this can happen at most once. *@
		<script>location.replace(location.href);</script>
		<noscript>
			<meta http-equiv="refresh" content="0"/>
		</noscript>
	}
	<HeadOutlet @rendermode="RenderMode"/>
</head>

<body>
<Routes @rendermode="RenderMode"/>
<script src="@Assets["js/interop.js"]"></script>
<script src="@Assets["_framework/blazor.web.js"]"></script>
</body>
</html>

@code {

	[CascadingParameter]
	private HttpContext HttpContext { get; set; } = default!;

	/// <summary>
	/// Interactive for the app, static for the pages that have to write a cookie.
	///
	/// Signing in sets a cookie, and a cookie is set with a response header — so it can only
	/// happen during a real HTTP request, never over the SignalR circuit. A page marked
	/// <c>[ExcludeFromInteractiveRouting]</c> makes AcceptsInteractiveRouting return false for
	/// the request that asked for it, and null here renders that request statically, giving the
	/// page an HttpContext to sign in with. Everything else is unchanged.
	/// </summary>
	private IComponentRenderMode? RenderMode => HttpContext.AcceptsInteractiveRouting()
		? new InteractiveServerRenderMode(prerender: false)
		: null;

	private bool RetryForCookie => HttpContext.Items.ContainsKey(AuthCookie.RetryFlag);

}
