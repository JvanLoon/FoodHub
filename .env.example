# Copy to `.env` (gitignored) and fill in. `docker compose` reads it automatically.
#
#   cp .env.example .env
#
# Generate each secret fresh — never reuse a value that has appeared in git.
#   openssl rand -base64 36     # POSTGRES_PASSWORD  (avoid ':' '@' '/' — they break the connection string)
#   openssl rand -base64 48     # JWT_KEY            (must be >= 32 bytes)

POSTGRES_PASSWORD=
PGADMIN_PASSWORD=
JWT_KEY=

# First-run only. The API creates this admin account when the users table is
# empty, then ignores these on every later boot. Sign in, change the password in
# the app, then blank both lines and recreate the container.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Production only (docker-compose.prod.yml): the public hostname Caddy gets a
# certificate for, and the address you want Let's Encrypt expiry notices at.
PUBLIC_HOSTNAME=
ACME_EMAIL=
