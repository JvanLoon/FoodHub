# Copy to `.env` (gitignored) and fill in. `docker compose` reads it automatically.
#
#   cp .env.example .env
#
# Generate each secret fresh — never reuse a value that has appeared in git.
#   openssl rand -base64 36     # POSTGRES_PASSWORD  (avoid ':' '@' '/' — they break the connection string)
#   openssl rand -base64 48     # JWT_KEY            (must be >= 32 bytes)

POSTGRES_PASSWORD=
PGADMIN_PASSWORD=
JWT_KEY=

# First-run only. The API creates this admin account when the users table is
# empty, then ignores these on every later boot. Sign in, change the password in
# the app, then blank both lines and recreate the container.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Production only (docker-compose.prod.yml).
#
# The hostname the site is served on, WITHOUT a scheme (e.g. foodhub.example.com).
# Cloudflare handles the certificate, but this is still load-bearing: the compose
# file feeds it to the API as https://$PUBLIC_HOSTNAME, which is the CORS
# allow-list entry. A wrong value here fails as an opaque CORS error in the
# browser, not as a startup error.
PUBLIC_HOSTNAME=

# Zero Trust dashboard -> Networks -> Tunnels -> your tunnel -> Install and run a
# connector; the token is the long string in the command it shows you. It embeds
# the tunnel's credentials, so it is a secret — never commit it.
CLOUDFLARE_TUNNEL_TOKEN=
