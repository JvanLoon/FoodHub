# LOCAL ONLY — gitignored. Do not commit.
#
# Variable names corrected: a double underscore is the ':' separator, a single
# underscore inside a segment is literal. The previous names
# (CONNECTION_STRINGS__DEFAULT_CONNECTION, WEB_SERVER__BASE_ADDRESS,
# DETAILED_ERRORS, LOGGING__LOGLEVEL__MICROSOFT_ASP_NET_CORE) resolved to config
# keys nothing reads, so none of them took effect.

Logging__LogLevel__Default=Information
Logging__LogLevel__Microsoft.AspNetCore=Warning

DetailedErrors=true

WebServer__BaseAddress=https://localhost:7049

# TODO rotate before deploying — this password is in the public git history.
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=FoodCalc;Username=foodhub;Password=aj7a!unEe#Ms*BqTE7WJ2a4tX1$^y7

# TODO rotate before deploying — this key is in the public git history.
# Must stay byte-for-byte identical to FoodCalc.Web/.env.
Jwt__Key=673JPGwfb$r!8SB3pVgXJR&&kaRSKqp5pGdtbg$H
Jwt__Issuer=FoodCalc
Jwt__Audience=FoodHub-Api-user

# First run only — creates the initial admin while the users table is empty.
# Blank both once you have signed in and changed the password.
Bootstrap__AdminEmail=admin@admin.nl
Bootstrap__AdminPassword=Admin123!
