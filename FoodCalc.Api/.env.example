# Local development configuration for FoodCalc.Api.
# Copy to `.env` (gitignored) and fill in. Loaded by DotNetEnv at startup.
#
#   cp .env.example .env
#
# NAMING RULES — these are not free-form. ASP.NET Core's environment-variable
# provider maps a DOUBLE underscore to the ':' config separator, and nothing else.
# A single underscore inside a segment is a literal character, so
# CONNECTION_STRINGS__DEFAULT_CONNECTION becomes the key
# "CONNECTION_STRINGS:DEFAULT_CONNECTION" and matches nothing. Segment names must
# equal the C# key (case-insensitively) with no underscores added.
#
#   GetConnectionString("DefaultConnection")  ->  ConnectionStrings__DefaultConnection
#   Configuration["WebServer:BaseAddress"]    ->  WebServer__BaseAddress
#
# Real environment variables always win over this file (NoClobber), so Aspire and
# docker compose keep working unchanged.

Logging__LogLevel__Default=Information
Logging__LogLevel__Microsoft.AspNetCore=Warning

DetailedErrors=true

WebServer__BaseAddress=https://localhost:7049

# Generate a new one — never reuse a value that has appeared in git history:
#   openssl rand -base64 36
# Avoid : @ / in the password; they terminate fields in the connection string.
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=FoodCalc;Username=foodhub;Password=

# Must be at least 32 bytes, and identical to the key FoodCalc.Web validates with:
#   openssl rand -base64 48
Jwt__Key=
Jwt__Issuer=FoodCalc

# First run only: creates the initial admin while the users table is empty, then
# does nothing ever again. Blank both once you have signed in and changed the
# password. Leaving them unset seeds no account at all.
Bootstrap__AdminEmail=
Bootstrap__AdminPassword=
